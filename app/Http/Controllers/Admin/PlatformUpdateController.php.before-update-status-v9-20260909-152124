<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\Website;
use App\Services\PlatformUpdates\PlatformUpdateService;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\Rule;

class PlatformUpdateController extends Controller
{
    public function __construct(
        protected PlatformUpdateService $updates
    ) {
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'product_type' => [
                'required',
                'string',
                Rule::in([
                    'core',
                    'website_type',
                    'module',
                    'addon',
                    'bundle',
                    'theme',
                ]),
            ],
            'product_id' => ['nullable', 'integer', 'min:1'],
            'name' => ['required', 'string', 'max:150'],
            'version' => ['required', 'string', 'max:50'],
            'description' => ['nullable', 'string'],
            'update_type' => [
                'required',
                'string',
                Rule::in([
                    'migration',
                    'package',
                    'hybrid',
                ]),
            ],
            'migration_path' => ['nullable', 'string', 'max:255'],
            'package_path' => ['nullable', 'string', 'max:255'],
            'requires_backup' => ['nullable', 'boolean'],
            'is_destructive' => ['nullable', 'boolean'],
            'status' => [
                'required',
                'string',
                Rule::in([
                    'draft',
                    'published',
                    'disabled',
                ]),
            ],
        ]);

        $exists = DB::table('platform_updates')
            ->where('product_type', $data['product_type'])
            ->where('version', $data['version'])
            ->when(
                !empty($data['product_id']),
                fn ($query) => $query->where('product_id', $data['product_id']),
                fn ($query) => $query->whereNull('product_id')
            )
            ->exists();

        if ($exists) {
            return back()
                ->withInput()
                ->withErrors([
                    'version' =>
                        'This product already has an update registered with this version.',
                ]);
        }

        DB::table('platform_updates')->insert([
            'product_type' => $data['product_type'],
            'product_id' => $data['product_id'] ?? null,
            'name' => $data['name'],
            'version' => $data['version'],
            'description' => $data['description'] ?? null,
            'update_type' => $data['update_type'],
            'status' => $data['status'],
            'migration_path' => $data['migration_path'] ?? null,
            'package_path' => $data['package_path'] ?? null,
            'manifest' => null,
            'prerequisites' => null,
            'requires_backup' =>
                $request->boolean('requires_backup', true),
            'is_destructive' =>
                $request->boolean('is_destructive', false),
            'published_at' =>
                $data['status'] === 'published' ? now() : null,
            'created_by' => auth()->id(),
            'created_at' => now(),
            'updated_at' => now(),
        ]);

        return back()->with(
            'success',
            'Update registered successfully.'
        );
    }

    public function dryRun(Request $request, int $updateId)
    {
        $data = $request->validate([
            'all_tenants' => ['nullable', 'boolean'],
            'website_ids' => ['nullable', 'array'],
            'website_ids.*' => ['integer', 'distinct'],
        ]);

        $allTenants = $request->boolean('all_tenants');

        if (!$allTenants && empty($data['website_ids'])) {
            return response()->json([
                'ok' => false,
                'message' => 'Select at least one tenant or choose All Tenants.',
            ], 422);
        }

        $update = DB::table('platform_updates')
            ->where('id', $updateId)
            ->first();

        abort_unless($update, 404);

        $websites = Website::query()
            ->when(
                !$allTenants,
                fn ($query) => $query->whereIn(
                    'id',
                    $data['website_ids'] ?? []
                )
            )
            ->orderBy('id')
            ->get();

        $results = [];

        foreach ($websites as $website) {
            $result = $this->updates->preview(
                $website,
                $update
            );

            $result['website_name'] =
                $website->name
                ?? $website->site_name
                ?? $website->domain
                ?? ('Website #' . $website->id);

            $results[] = $result;
        }

        return response()->json([
            'ok' => true,
            'update_id' => $update->id,
            'results' => $results,
        ]);
    }

    public function execute(Request $request, int $updateId)
    {
        $data = $request->validate([
            'all_tenants' => ['nullable', 'boolean'],
            'website_ids' => ['nullable', 'array'],
            'website_ids.*' => ['integer', 'distinct'],
        ]);

        $allTenants = $request->boolean('all_tenants');

        if (!$allTenants && empty($data['website_ids'])) {
            return response()->json([
                'ok' => false,
                'message' => 'Select at least one tenant or choose All Tenants.',
            ], 422);
        }

        $update = DB::table('platform_updates')
            ->where('id', $updateId)
            ->first();

        abort_unless($update, 404);

        if ($update->status !== 'published') {
            return response()->json([
                'ok' => false,
                'message' => 'Only published updates can be executed.',
            ], 422);
        }

        if ((bool) $update->is_destructive) {
            return response()->json([
                'ok' => false,
                'message' =>
                    'Destructive updates are blocked from the standard updater.',
            ], 422);
        }

        $websiteIds = $allTenants
            ? Website::query()->orderBy('id')->pluck('id')->all()
            : ($data['website_ids'] ?? []);

        $results = $this->updates->executeMany(
            $update,
            $websiteIds,
            auth()->id()
        );

        return response()->json([
            'ok' => true,
            'update_id' => $update->id,
            'results' => $results,
        ]);
    }
}
