<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\WebsiteType;
use App\Services\ProductStorageService;
use App\Services\Website\Deployment\WebsiteTypeDeploymentProfileService;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;
use Illuminate\View\View;
use InvalidArgumentException;

class WebsiteTypeController extends Controller
{
    /*
     * ESUBIZ_ADMIN_WEBSITE_TYPE_COMPOSITION_V5
     *
     * Website Type Add/Edit is the administrative authority for
     * both SaaS and off-server deployment composition.
     *
     * Admin may independently configure:
     * - Themes
     * - Default Theme
     * - Modules
     * - Add-ons
     * - Add-on Bundles
     *
     * No Website Type names are hardcoded.
     */

    /*
     * ESUBIZ_WEBSITE_TYPE_AJAX_TABLE_V8
     *
     * Admin Website Types are rendered 10 per page.
     * AJAX pagination requests return only the table fragment so
     * Previous / Next navigation does not reload the Admin page.
     */
    public function index(Request $request): View
    {
        $websiteTypes = WebsiteType::query()
            ->orderBy('sort_order')
            ->orderBy('name')
            ->paginate(10)
            ->withQueryString();

        if ($request->ajax()) {
            return view(
                'admin.website-types._table',
                [
                    'websiteTypes' => $websiteTypes,
                ]
            );
        }

        return view('admin.website-types.index', [
            'websiteTypes' => $websiteTypes,
        ]);
    }

    public function create(ProductStorageService $storage): View
    {
        return view('admin.website-types.create', [
            'packages' => $storage->websiteTypePackages(),
            'deploymentCatalog' => $this->deploymentCatalog(),
            'deploymentProfiles' => $this->emptyDeploymentProfiles(),
        ]);
    }

    public function store(
        Request $request,
        WebsiteTypeDeploymentProfileService $deploymentProfiles
    ): RedirectResponse {
        $validated = $this->validateWebsiteType($request);

        $validated['slug'] = $validated['slug'] ?? Str::slug($validated['name']);
        $validated['sort_order'] = $validated['sort_order'] ?? 0;

        $this->applyBooleanFields($request, $validated);

        if ($request->hasFile('image')) {
            $validated['image'] = $this->storeWebsiteTypeImage($request);
        }

        $websiteType = DB::transaction(function () use (
            $validated,
            $request,
            $deploymentProfiles
        ) {
            $websiteType = WebsiteType::create($validated);

            $this->saveDeploymentProfiles(
                $request,
                $websiteType,
                $deploymentProfiles
            );

            return $websiteType;
        });

        return redirect()
            ->route('admin.website-types.index')
            ->with('success', 'Website type created successfully.');
    }

    public function edit(
        WebsiteType $websiteType,
        ProductStorageService $storage,
        WebsiteTypeDeploymentProfileService $deploymentProfiles
    ): View {
        return view('admin.website-types.edit', [
            'websiteType' => $websiteType,
            'packages' => $storage->websiteTypePackages(),
            'deploymentCatalog' => $this->deploymentCatalog(),
            'deploymentProfiles' => [
                'saas' => $this->resolvedProfile(
                    $deploymentProfiles,
                    $websiteType,
                    'saas'
                ),
                'off_server' => $this->resolvedProfile(
                    $deploymentProfiles,
                    $websiteType,
                    'off_server'
                ),
            ],
        ]);
    }

    public function update(
        Request $request,
        WebsiteType $websiteType,
        WebsiteTypeDeploymentProfileService $deploymentProfiles
    ): RedirectResponse {
        $validated = $this->validateWebsiteType(
            $request,
            $websiteType
        );

        $validated['slug'] = $validated['slug'] ?? Str::slug($validated['name']);
        $validated['sort_order'] = $validated['sort_order'] ?? 0;

        $this->applyBooleanFields($request, $validated);

        if ($request->hasFile('image')) {
            $newImage = $this->storeWebsiteTypeImage($request);

            if (
                $newImage
                && $websiteType->image
            ) {
                Storage::disk('public')->delete(
                    $websiteType->image
                );
            }

            $validated['image'] = $newImage;
        } else {
            unset($validated['image']);
        }

        DB::transaction(function () use (
            $validated,
            $request,
            $websiteType,
            $deploymentProfiles
        ) {
            $websiteType->update($validated);

            $this->saveDeploymentProfiles(
                $request,
                $websiteType,
                $deploymentProfiles
            );
        });

        return redirect()
            ->route('admin.website-types.index')
            ->with('success', 'Website type updated successfully.');
    }

    private function validateWebsiteType(
        Request $request,
        ?WebsiteType $websiteType = null
    ): array {
        $slugRule = 'unique:website_types,slug';

        if ($websiteType) {
            $slugRule .= ',' . $websiteType->id;
        }

        return $request->validate([
            'name' => ['required', 'string', 'max:255'],
            'slug' => ['nullable', 'string', 'max:255', $slugRule],
            'package_key' => ['nullable', 'string', 'max:255'],
            'package_version' => ['nullable', 'string', 'max:255'],
            'description' => ['nullable', 'string'],
            'icon' => ['nullable', 'string', 'max:255'],
            'image' => [
                'nullable',
                'image',
                'mimes:jpg,jpeg,png,webp,svg',
                'max:5120',
            ],
            'is_active' => ['nullable', 'boolean'],
            'show_in_user_wizard' => ['nullable', 'boolean'],
            'show_in_developer_wizard' => ['nullable', 'boolean'],
            'wizard_settings' => ['nullable', 'array'],
            'saas_price' => ['nullable', 'numeric', 'min:0'],
            'saas_billing_period' => [
                'nullable',
                'integer',
                'min:1',
                'required_with:saas_price',
            ],
            'saas_billing_interval' => [
                'nullable',
                'string',
                'max:20',
                'required_with:saas_price',
            ],
            'off_server_price' => ['nullable', 'numeric', 'min:0'],
            'sort_order' => ['nullable', 'integer', 'min:0'],

            'deployment' => ['nullable', 'array'],

            'deployment.saas' => ['nullable', 'array'],
            'deployment.saas.enabled' => ['nullable', 'boolean'],
            'deployment.saas.themes' => ['nullable', 'array'],
            'deployment.saas.themes.*' => ['integer', 'exists:catalog_products,id'],
            'deployment.saas.default_theme' => [
                'nullable',
                'integer',
                'exists:catalog_products,id',
            ],
            'deployment.saas.modules' => ['nullable', 'array'],
            'deployment.saas.modules.*' => ['integer', 'exists:catalog_products,id'],
            'deployment.saas.addons' => ['nullable', 'array'],
            'deployment.saas.addons.*' => ['integer', 'exists:catalog_products,id'],
            'deployment.saas.bundles' => ['nullable', 'array'],
            'deployment.saas.bundles.*' => ['integer', 'exists:catalog_products,id'],

            'deployment.off_server' => ['nullable', 'array'],
            'deployment.off_server.enabled' => ['nullable', 'boolean'],
            'deployment.off_server.themes' => ['nullable', 'array'],
            'deployment.off_server.themes.*' => [
                'integer',
                'exists:catalog_products,id',
            ],
            'deployment.off_server.default_theme' => [
                'nullable',
                'integer',
                'exists:catalog_products,id',
            ],
            'deployment.off_server.modules' => ['nullable', 'array'],
            'deployment.off_server.modules.*' => [
                'integer',
                'exists:catalog_products,id',
            ],
            'deployment.off_server.addons' => ['nullable', 'array'],
            'deployment.off_server.addons.*' => [
                'integer',
                'exists:catalog_products,id',
            ],
            'deployment.off_server.bundles' => ['nullable', 'array'],
            'deployment.off_server.bundles.*' => [
                'integer',
                'exists:catalog_products,id',
            ],
        ]);
    }

    private function applyBooleanFields(
        Request $request,
        array &$validated
    ): void {
        $validated['is_active'] =
            $request->boolean('is_active');

        $validated['show_in_user_wizard'] =
            $request->boolean('show_in_user_wizard');

        $validated['show_in_developer_wizard'] =
            $request->boolean('show_in_developer_wizard');

        unset($validated['deployment']);
    }

    private function saveDeploymentProfiles(
        Request $request,
        WebsiteType $websiteType,
        WebsiteTypeDeploymentProfileService $service
    ): void {
        foreach (['saas', 'off_server'] as $deployment) {
            $input = $request->input(
                "deployment.{$deployment}",
                []
            );

            $profileId = $service->saveProfile(
                $websiteType,
                $deployment,
                [
                    'is_enabled' => (bool) data_get(
                        $input,
                        'enabled',
                        true
                    ),
                    'configuration' => [],
                ]
            );

            $components = [];

            /*
             * ESUBIZ_WEBSITE_TYPE_DEFAULT_THEME_SAVE_V7
             *
             * A selected default Theme is necessarily part of the
             * Website Type Theme assignment. This keeps the default
             * selector and Theme checkboxes from producing conflicting
             * deployment state.
             */
            $defaultTheme = (int) data_get(
                $input,
                'default_theme',
                0
            );

            $themeIds = (array) data_get(
                $input,
                'themes',
                []
            );

            if ($defaultTheme > 0) {
                $themeIds[] = $defaultTheme;
            }

            $this->appendComponents(
                $components,
                $themeIds,
                'theme'
            );

            $this->appendComponents(
                $components,
                (array) data_get($input, 'modules', []),
                'module'
            );

            $this->appendComponents(
                $components,
                (array) data_get($input, 'addons', []),
                'addon'
            );

            $this->appendComponents(
                $components,
                (array) data_get($input, 'bundles', []),
                'bundle'
            );

            $service->syncComponents(
                $profileId,
                $components
            );

            if ($defaultTheme > 0) {
                $service->setDefaultTheme(
                    $profileId,
                    $defaultTheme
                );
            } else {
                DB::table('website_type_deployment_profiles')
                    ->where('id', $profileId)
                    ->update([
                        'default_theme_catalog_product_id' => null,
                        'updated_at' => now(),
                    ]);
            }
        }
    }

    private function appendComponents(
        array &$components,
        array $catalogProductIds,
        string $componentType
    ): void {
        foreach (
            array_values(
                array_unique(
                    array_filter(
                        array_map('intval', $catalogProductIds)
                    )
                )
            ) as $sort => $catalogProductId
        ) {
            $components[] = [
                'catalog_product_id' => $catalogProductId,
                'component_type' => $componentType,
                'is_required' => true,
                'sort_order' => $sort,
                'configuration' => [],
            ];
        }
    }

    private function deploymentCatalog(): array
    {
        /*
         * ESUBIZ_WEBSITE_TYPE_AUTO_CATALOG_SYNC_V6
         *
         * Ensure native Themes, Modules, Add-ons and Bundles are
         * synchronized into the canonical catalog before rendering
         * the Website Type Add/Edit selectors.
         */
        app(
            \App\Services\Marketplace\Catalog\NativeProductCatalogSyncService::class
        )->syncAll();

        $products = DB::table('catalog_products')
            ->where('is_active', true)
            ->whereIn(
                'product_type',
                ['theme', 'module', 'addon', 'bundle']
            )
            ->orderBy('product_type')
            ->orderBy('name')
            ->get([
                'id',
                'name',
                'slug',
                'product_type',
            ])
            ->groupBy('product_type');

        return [
            'themes' => $products->get('theme', collect()),
            'modules' => $products->get('module', collect()),
            'addons' => $products->get('addon', collect()),
            'bundles' => $products->get('bundle', collect()),
        ];
    }

    private function emptyDeploymentProfiles(): array
    {
        $empty = [
            'profile_id' => null,
            'is_enabled' => true,
            'themes' => [],
            'default_theme' => null,
            'selected_theme' => null,
            'modules' => [],
            'addons' => [],
            'bundles' => [],
            'configuration' => [],
        ];

        return [
            'saas' => $empty,
            'off_server' => $empty,
        ];
    }

    private function resolvedProfile(
        WebsiteTypeDeploymentProfileService $service,
        WebsiteType $websiteType,
        string $deployment
    ): array {
        try {
            return $service->resolve(
                $websiteType,
                $deployment
            );
        } catch (\RuntimeException $exception) {
            if (
                !str_contains(
                    $exception->getMessage(),
                    'has no enabled'
                )
            ) {
                throw $exception;
            }

            $profileId = $service->saveProfile(
                $websiteType,
                $deployment,
                [
                    'is_enabled' => true,
                    'configuration' => [],
                ]
            );

            return $service->resolve(
                $websiteType,
                $deployment
            );
        }
    }

    private function storeWebsiteTypeImage(
        Request $request
    ): ?string {
        $file = $request->file('image');

        if (!$file) {
            return null;
        }

        $optimized =
            /* ESUBIZ_WEBSITE_TYPE_UNIVERSAL_MEDIA_STORE_V1 */
            app(
                \App\Services\Media\CentralMediaService::class
            )->storeMediaToDisk(
                $file,
                'public',
                'website-types',
                [
                    'maximum_edge' => 1920,
                    'image_quality' => 82,
                ]
            );

        return $optimized
            ?: $file->store(
                'website-types',
                'public'
            );
    }
}
