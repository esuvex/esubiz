<?php

namespace App\Http\Controllers\Core;

use App\Http\Controllers\Controller;
use App\Services\Core\Installation\CoreInstallationState;
use Illuminate\Http\Client\ConnectionException;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Str;
use Illuminate\View\View;
use RuntimeException;
use Throwable;

/**
 * ESUBIZ_CORE_FIRST_RUN_SETUP_CONTROLLER_V2
 *
 * First-run setup for OFF-SERVER Core.
 *
 * Customer enters from:
 *
 *     https://example.com/
 *
 * Initial Core installation is manual:
 *
 * Upload ZIP -> Unzip -> Visit domain -> Fill setup form ->
 * Validate Esubiz license -> Configure Core -> Finish.
 *
 * Central Esubiz does NOT automatically install Core initially.
 */
class CoreSetupController extends Controller
{
    public function __construct(
        protected CoreInstallationState $installation
    ) {
    }

    /**
     * Render first-run setup.
     */
    public function start(
        Request $request
    ): View {
        $this->assertAvailable();

        return view(
            'core.installation.setup',
            [
                'detectedDomain' =>
                    $request->getHost(),

                'generatedInstanceUuid' =>
                    (string) Str::uuid(),
            ]
        );
    }

    /**
     * Validate first-run information and verify the
     * supplied Esubiz license with Central.
     *
     * Database writing/migrations/admin creation will be added
     * in the next installation stage.
     */
    public function store(
        Request $request
    ): RedirectResponse {
        $this->assertAvailable();

        $validated = $request->validate([
            'site_name' => [
                'required',
                'string',
                'max:191',
            ],

            'domain' => [
                'required',
                'string',
                'max:255',
            ],

            'license_key' => [
                'required',
                'string',
                'max:191',
            ],

            'core_instance_uuid' => [
                'required',
                'uuid',
            ],

            'db_host' => [
                'required',
                'string',
                'max:255',
            ],

            'db_port' => [
                'required',
                'integer',
                'min:1',
                'max:65535',
            ],

            'db_database' => [
                'required',
                'string',
                'max:191',
            ],

            'db_username' => [
                'required',
                'string',
                'max:191',
            ],

            'db_password' => [
                'nullable',
                'string',
                'max:1000',
            ],

            'admin_name' => [
                'required',
                'string',
                'max:191',
            ],

            'admin_email' => [
                'required',
                'email',
                'max:255',
            ],

            'admin_password' => [
                'required',
                'string',
                'min:8',
                'max:255',
                'confirmed',
            ],
        ]);

        try {
            $license = $this->validateCentralLicense(
                $validated
            );

            /*
             * Store validated first-stage setup data in session only.
             *
             * Sensitive values are NOT written into the installation
             * lock file.
             *
             * Next stage will:
             *
             * - test DB connection;
             * - write .env safely;
             * - generate APP_KEY when required;
             * - run Core migrations;
             * - create site/admin;
             * - persist instance identity;
             * - mark installation complete.
             */
            $request->session()->put(
                'core_first_run_setup',
                [
                    'site_name' =>
                        $validated['site_name'],

                    'domain' =>
                        $validated['domain'],

                    'license_key' =>
                        $validated['license_key'],

                    'core_instance_uuid' =>
                        $validated[
                            'core_instance_uuid'
                        ],

                    'db_host' =>
                        $validated['db_host'],

                    'db_port' =>
                        (int) $validated[
                            'db_port'
                        ],

                    'db_database' =>
                        $validated[
                            'db_database'
                        ],

                    'db_username' =>
                        $validated[
                            'db_username'
                        ],

                    'db_password' =>
                        $validated[
                            'db_password'
                        ] ?? '',

                    'admin_name' =>
                        $validated[
                            'admin_name'
                        ],

                    'admin_email' =>
                        $validated[
                            'admin_email'
                        ],

                    'admin_password' =>
                        $validated[
                            'admin_password'
                        ],

                    'license_validation' =>
                        $license,
                ]
            );

            return back()->with(
                'success',
                'License validated successfully. Core setup is ready for database installation.'
            );
        } catch (RuntimeException $e) {
            return back()
                ->withInput(
                    $request->except([
                        'db_password',
                        'admin_password',
                        'admin_password_confirmation',
                    ])
                )
                ->withErrors([
                    'license_key' =>
                        $e->getMessage(),
                ]);
        } catch (Throwable $e) {
            report($e);

            return back()
                ->withInput(
                    $request->except([
                        'db_password',
                        'admin_password',
                        'admin_password_confirmation',
                    ])
                )
                ->withErrors([
                    'license_key' =>
                        'Unable to validate the Esubiz license right now.',
                ]);
        }
    }

    /**
     * Validate the initial Core license against Central Esubiz.
     *
     * Initial Core packages are treated as product_type=core.
     *
     * @param array<string,mixed> $setup
     * @return array<string,mixed>
     */
    protected function validateCentralLicense(
        array $setup
    ): array {
        $central = rtrim(
            (string) config(
                'services.esubiz.marketplace_url',
                'https://esubiz.com'
            ),
            '/'
        );

        try {
            $response = Http::asJson()
                ->acceptJson()
                ->timeout(20)
                ->post(
                    $central
                        . '/marketplace/licenses/validate',
                    [
                        'license_key' =>
                            $setup['license_key'],

                        'core_instance_uuid' =>
                            $setup[
                                'core_instance_uuid'
                            ],

                        'product_type' =>
                            'core',

                        /*
                         * Core product identity will later come directly
                         * from the signed Core package manifest.
                         *
                         * V1 reserves ID 1 for the base Core package.
                         */
                        'product_id' =>
                            1,

                        'product_slug' =>
                            'core',

                        'domain' =>
                            $setup['domain'],

                        'core_version' =>
                            config(
                                'app.version'
                            ),

                        'installation_fingerprint' =>
                            hash(
                                'sha256',
                                strtolower(
                                    trim(
                                        $setup['domain']
                                    )
                                )
                                . '|'
                                . $setup[
                                    'core_instance_uuid'
                                ]
                            ),
                    ]
                );
        } catch (ConnectionException $e) {
            throw new RuntimeException(
                'Esubiz license server could not be reached.'
            );
        }

        $payload =
            $response->json();

        if (
            !$response->successful()
            || !is_array($payload)
            || !($payload['valid'] ?? false)
        ) {
            throw new RuntimeException(
                is_array($payload)
                    ? (
                        $payload['message']
                            ?? 'Esubiz license validation failed.'
                    )
                    : 'Esubiz license validation failed.'
            );
        }

        return $payload;
    }

    protected function assertAvailable(): void
    {
        if (!$this->isOffServer()) {
            abort(404);
        }

        if ($this->installation->isInstalled()) {
            abort(404);
        }
    }

    protected function isOffServer(): bool
    {
        return strtolower(
            trim(
                (string) config(
                    'services.esubiz.deployment',
                    env(
                        'ESUBIZ_DEPLOYMENT',
                        'saas'
                    )
                )
            )
        ) === 'off_server';
    }
}
