<?php

namespace App\Http\Controllers\Core;

use App\Http\Controllers\Controller;
use App\Services\Core\Installation\CoreInstallationState;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\View\View;
use RuntimeException;

/**
 * ESUBIZ_CORE_FIRST_RUN_SETUP_CONTROLLER_V1
 *
 * Internal first-run setup controller for OFF-SERVER Core.
 *
 * Customer entry remains:
 *
 * https://example.com/
 *
 * The root first-run gate redirects internally here only while Core
 * has not yet completed initial installation.
 *
 * There is no permanent public /install lifecycle.
 */
class CoreSetupController extends Controller
{
    public function __construct(
        protected CoreInstallationState $installation
    ) {
    }

    /**
     * Render first-run setup.
     */
    public function start(): View
    {
        $this->assertAvailable();

        return view(
            'core.installation.setup'
        );
    }

    /**
     * Process initial Core setup.
     *
     * This is intentionally only the orchestration shell for now.
     *
     * Next steps will wire:
     *
     * - environment/database configuration;
     * - Central Esubiz license validation;
     * - database migrations;
     * - admin account creation;
     * - website/site configuration;
     * - final installation lock.
     */
    public function store(
        Request $request
    ): RedirectResponse {
        $this->assertAvailable();

        /*
         * We deliberately do NOT mark Core installed yet.
         *
         * The installation lock must only be written after every
         * required setup stage succeeds.
         */
        throw new RuntimeException(
            'Core first-run installation processor is not wired yet.'
        );
    }

    /**
     * Setup exists only for an uninstalled off-server Core.
     */
    protected function assertAvailable(): void
    {
        if (!$this->isOffServer()) {
            abort(404);
        }

        if ($this->installation->isInstalled()) {
            abort(404);
        }
    }

    protected function isOffServer(): bool
    {
        return strtolower(
            trim(
                (string) config(
                    'services.esubiz.deployment',
                    env(
                        'ESUBIZ_DEPLOYMENT',
                        'saas'
                    )
                )
            )
        ) === 'off_server';
    }
}
