<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Services\Licensing\OffServerLicenseRegistrationService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;
use RuntimeException;
use Throwable;

/**
 * ============================================================
 * ESUBIZ OFF-SERVER CORE LICENCE ACTIVATION
 * ============================================================
 *
 * Called by a legitimate off-server Esubiz Core installation.
 *
 * Flow:
 *
 * purchased licence
 *      ↓
 * Central licence registration
 *      ↓
 * permanent domain lock
 *      ↓
 * Central Website registration
 *      ↓
 * website_id + website_uuid
 *
 * API application binding is Checkpoint 4.
 */
class OffServerLicenseController extends Controller
{
    /**
     * ESUBIZ_OFF_SERVER_LICENSE_PREINSTALL_VALIDATION
     *
     * PRE-INSTALL VALIDATION ONLY.
     *
     * This endpoint MUST NOT:
     *
     * - activate the licence
     * - permanently bind the domain
     * - create a Central website
     * - issue API credentials
     *
     * It only answers:
     *
     * "Is this genuine Esubiz licence currently allowed to
     * continue installation on this domain?"
     *
     * If installation later fails or is abandoned, a pending
     * licence remains completely unactivated and can still be
     * used for another installation attempt/domain.
     */
    public function validate(
        Request $request,
        OffServerLicenseRegistrationService $licenses
    ): JsonResponse {

        $data =
            $request->validate([
                'license_key' => [
                    'required',
                    'string',
                    'max:255',
                ],

                'domain' => [
                    'required',
                    'string',
                    'max:500',
                ],

                'installation_uuid' => [
                    'required',
                    'uuid',
                ],
            ]);


        try {

            $registration =
                DB::table(
                    'off_server_license_registrations'
                )
                    ->where(
                        'license_key',
                        trim(
                            $data['license_key']
                        )
                    )
                    ->first();


            if (!$registration) {

                return response()->json(
                    [
                        'success' =>
                            false,

                        'valid' =>
                            false,

                        'message' =>
                            'The Esubiz Core licence is invalid.',
                    ],
                    422
                );
            }


            /*
             * Revoked and suspended licences cannot begin or
             * continue an installation.
             */
            if (
                in_array(
                    $registration->status,
                    [
                        OffServerLicenseRegistrationService::STATUS_REVOKED,
                        OffServerLicenseRegistrationService::STATUS_SUSPENDED,
                    ],
                    true
                )
            ) {

                return response()->json(
                    [
                        'success' =>
                            false,

                        'valid' =>
                            false,

                        'message' =>
                            'This Esubiz Core licence is not currently available for installation.',
                    ],
                    422
                );
            }


            /*
             * Normalize and CHECK the domain lock only.
             *
             * assertDomainLock() does not mutate anything.
             *
             * Pending licence:
             * any valid first domain may proceed.
             *
             * Active licence:
             * only its permanently registered domain may proceed.
             */
            $domain =
                $licenses->assertDomainLock(
                    $registration,
                    $data['domain']
                );


            /*
             * CRITICAL:
             *
             * Do NOT update:
             *
             * registered_domain
             * domain_hash
             * status
             * activated_at
             * installation_uuid
             * website_id
             *
             * Validation must remain non-activating.
             */
            return response()->json([
                'success' =>
                    true,

                'valid' =>
                    true,

                'can_install' =>
                    true,

                'message' =>
                    'Esubiz Core licence is valid. Installation may continue.',

                'license' => [
                    'status' =>
                        $registration->status,

                    'domain_locked' =>
                        !empty(
                            $registration->registered_domain
                        ),

                    'registered_domain' =>
                        $registration->registered_domain,
                ],

                'installation' => [
                    'requested_domain' =>
                        $domain,

                    'uuid' =>
                        $data['installation_uuid'],
                ],

                /*
                 * This remains null for a brand-new pending licence.
                 * A Central website identity is created only after
                 * successful installation calls activate().
                 */
                'website' => [
                    'id' =>
                        $registration->website_id,

                    'registered' =>
                        !empty(
                            $registration->website_id
                        ),
                ],
            ]);


        } catch (
            RuntimeException $exception
        ) {

            return response()->json(
                [
                    'success' =>
                        false,

                    'valid' =>
                        false,

                    'can_install' =>
                        false,

                    'message' =>
                        $exception->getMessage(),
                ],
                422
            );


        } catch (
            Throwable $exception
        ) {

            report(
                $exception
            );


            return response()->json(
                [
                    'success' =>
                        false,

                    'valid' =>
                        false,

                    'message' =>
                        'Esubiz Core licence could not be validated.',
                ],
                500
            );
        }
    }


    public function activate(
        Request $request,
        OffServerLicenseRegistrationService $licenses
    ): JsonResponse {

        $data =
            $request->validate([
                'license_key' => [
                    'required',
                    'string',
                    'max:255',
                ],

                'domain' => [
                    'required',
                    'string',
                    'max:500',
                ],

                'installation_uuid' => [
                    'required',
                    'uuid',
                ],
            ]);


        try {

            /*
             * ----------------------------------------------------
             * FIND CANONICAL CENTRAL LICENCE REGISTRATION
             * ----------------------------------------------------
             *
             * The registration must already exist centrally.
             *
             * Therefore somebody cannot manufacture a random
             * licence key on a nulled Core and obtain a Central
             * website registration.
             */
            $registration =
                DB::table(
                    'off_server_license_registrations'
                )
                    ->where(
                        'license_key',
                        trim(
                            $data['license_key']
                        )
                    )
                    ->first();


            if (!$registration) {

                return response()->json(
                    [
                        'success' =>
                            false,

                        'message' =>
                            'The Esubiz Core licence is invalid.',
                    ],
                    422
                );
            }


            if (
                $registration->status
                === OffServerLicenseRegistrationService::STATUS_REVOKED
            ) {

                return response()->json(
                    [
                        'success' =>
                            false,

                        'message' =>
                            'This Esubiz Core licence has been revoked.',
                    ],
                    422
                );
            }


            /*
             * ----------------------------------------------------
             * INSTALLATION UUID SAFETY
             * ----------------------------------------------------
             */
            if (
                !Str::isUuid(
                    $data['installation_uuid']
                )
            ) {
                return response()->json(
                    [
                        'success' =>
                            false,

                        'message' =>
                            'Installation identity is invalid.',
                    ],
                    422
                );
            }


            /*
             * ----------------------------------------------------
             * DOMAIN LOCK + CENTRAL WEBSITE REGISTRATION
             * ----------------------------------------------------
             *
             * activateAndRegisterWebsite() guarantees:
             *
             * - first valid activation permanently locks domain
             * - same licence + same domain is allowed
             * - same licence + different domain is rejected
             * - Central off-server Website record is created once
             * - repeated activation returns same website identity
             */
            $result =
                $licenses->activateAndRegisterWebsite(
                    (int) $registration->id,
                    $data['domain'],
                    $data['installation_uuid']
                );


            return response()->json([
                'success' =>
                    true,

                'message' =>
                    'Esubiz Core licence activated successfully.',

                'website' => [
                    'id' =>
                        $result['website_id'],

                    'uuid' =>
                        $result['website_uuid'],

                    'deployment_type' =>
                        $result['deployment_type'],

                    'domain' =>
                        $result['registered_domain'],

                    'registry_status' =>
                        $result['registry_status'],
                ],

                'license' => [
                    'status' =>
                        $result['license_status'],

                    'domain_locked' =>
                        true,
                ],

                'installation' => [
                    'uuid' =>
                        $result['installation_uuid'],
                ],
            ]);


        } catch (
            RuntimeException $exception
        ) {

            /*
             * Includes permanent domain-lock rejection.
             */
            return response()->json(
                [
                    'success' =>
                        false,

                    'message' =>
                        $exception->getMessage(),
                ],
                422
            );


        } catch (
            Throwable $exception
        ) {

            report(
                $exception
            );


            return response()->json(
                [
                    'success' =>
                        false,

                    'message' =>
                        'Esubiz Core licence activation could not be completed.',
                ],
                500
            );
        }
    }
}
