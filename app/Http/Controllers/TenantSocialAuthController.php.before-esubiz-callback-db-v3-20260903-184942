<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Str;

class TenantSocialAuthController extends Controller
{
    /* ESUBIZ_CORE_GOOGLE_DYNAMIC_CALLBACK_V55 */
    /*
     * ESUBIZ_CORE_GOOGLE_OAUTH_RUNTIME_V2
     */


    /**
     * ESUBIZ_CORE_UNIVERSAL_ESUBIZ_PROVIDER_V1
     *
     * Universal Esubiz authentication provider.
     *
     * The Core-side flow is identical for SaaS, custom-domain
     * and off-server installations:
     *
     * Core -> Central authorize -> Core callback
     *      -> Central token -> Central user -> local site_users.
     *
     * Deployment type does not change this protocol.
     */
    public function esubizRedirect(Request $request)
    {
        $application = $this->resolveEsubizApplication();

        if (!$application) {
            return $this->loginError(
                'Esubiz SSO is not configured for this website.'
            );
        }

        $clientId = trim(
            (string) ($application['client_id'] ?? '')
        );

        if ($clientId === '') {
            return $this->loginError(
                'Esubiz SSO is not configured for this website.'
            );
        }

        $state = \Illuminate\Support\Str::random(64);

        $request->session()->put(
            'core_esubiz_oauth_state',
            $state
        );

        $callback =
            $request->getSchemeAndHttpHost()
            . '/auth/esubiz/callback';

        $query = http_build_query(
            [
                'client_id' => $clientId,
                'redirect_uri' => $callback,
                'state' => $state,
            ],
            '',
            '&',
            PHP_QUERY_RFC3986
        );

        return redirect()->away(
            'https://esubiz.com/oauth/authorize?' . $query
        );
    }


    /**
     * Universal Esubiz authentication callback.
     */
    public function esubizCallback(Request $request)
    {
        $expectedState = $request->session()->pull(
            'core_esubiz_oauth_state'
        );

        $receivedState =
            $request->string('state')->toString();

        if (
            $expectedState === null
            || $receivedState === ''
            || !hash_equals(
                (string) $expectedState,
                $receivedState
            )
        ) {
            return $this->loginError(
                'The Esubiz authentication request could not be verified.'
            );
        }

        $code = $request->string('code')->toString();

        if ($code === '') {
            return $this->loginError(
                'Esubiz did not return an authorization code.'
            );
        }

        $application = $this->resolveEsubizApplication();

        if (!$application) {
            return $this->loginError(
                'Esubiz SSO is not configured for this website.'
            );
        }

        $clientId = trim(
            (string) ($application['client_id'] ?? '')
        );

        $clientSecret = trim(
            (string) ($application['client_secret'] ?? '')
        );

        if (
            $clientId === ''
            || $clientSecret === ''
        ) {
            return $this->loginError(
                'Esubiz SSO application credentials are unavailable.'
            );
        }

        $callback =
            $request->getSchemeAndHttpHost()
            . '/auth/esubiz/callback';

        try {
            $tokenResponse =
                \Illuminate\Support\Facades\Http::asForm()
                    ->acceptJson()
                    ->timeout(20)
                    ->post(
                        'https://esubiz.com/oauth/token',
                        [
                            'client_id' => $clientId,
                            'client_secret' => $clientSecret,
                            'code' => $code,
                            'redirect_uri' => $callback,
                        ]
                    );

            if (!$tokenResponse->successful()) {
                return $this->loginError(
                    'Esubiz authentication could not be completed.'
                );
            }

            $accessToken = trim(
                (string) $tokenResponse->json(
                    'access_token'
                )
            );

            if ($accessToken === '') {
                return $this->loginError(
                    'Esubiz did not return an access token.'
                );
            }

            $userResponse =
                \Illuminate\Support\Facades\Http::withToken(
                    $accessToken
                )
                ->acceptJson()
                ->timeout(20)
                ->get(
                    'https://esubiz.com/oauth/user'
                );

            if (!$userResponse->successful()) {
                return $this->loginError(
                    'The Esubiz account could not be retrieved.'
                );
            }

            $email = strtolower(
                trim(
                    (string) $userResponse->json('email')
                )
            );

            $name = trim(
                (string) $userResponse->json('name')
            );

            $centralUserId = (int)
                $userResponse->json('id');

            if ($email === '') {
                return $this->loginError(
                    'The Esubiz account does not contain a usable email address.'
                );
            }

            /*
             * Esubiz authenticates the identity.
             * Core owns the local website account.
             */
            $db =
                \Illuminate\Support\Facades\DB::connection(
                    'website_tenant'
                );

            $schema =
                \Illuminate\Support\Facades\Schema::connection(
                    'website_tenant'
                );

            if (!$schema->hasTable('site_users')) {
                return $this->loginError(
                    'The local user system is unavailable.'
                );
            }

            $columns =
                $schema->getColumnListing('site_users');

            $user = $db
                ->table('site_users')
                ->whereRaw(
                    'LOWER(email) = ?',
                    [$email]
                )
                ->first();

            if ($user) {
                $userId = (int) $user->id;

                $update = [
                    'email' => $email,
                    'updated_at' => now(),
                ];

                if (
                    in_array(
                        'name',
                        $columns,
                        true
                    )
                    && $name !== ''
                ) {
                    $update['name'] = $name;
                }

                if (
                    in_array(
                        'is_active',
                        $columns,
                        true
                    )
                ) {
                    $update['is_active'] = true;
                }

                if (
                    in_array(
                        'last_login_at',
                        $columns,
                        true
                    )
                ) {
                    $update['last_login_at'] = now();
                }

                $db
                    ->table('site_users')
                    ->where('id', $userId)
                    ->update($update);

            } else {
                $insert = [
                    'email' => $email,
                    'password' =>
                        \Illuminate\Support\Facades\Hash::make(
                            \Illuminate\Support\Str::random(64)
                        ),
                    'created_at' => now(),
                    'updated_at' => now(),
                ];

                if (
                    in_array(
                        'name',
                        $columns,
                        true
                    )
                ) {
                    $insert['name'] =
                        $name !== ''
                            ? $name
                            : $email;
                }

                if (
                    in_array(
                        'is_active',
                        $columns,
                        true
                    )
                ) {
                    $insert['is_active'] = true;
                }

                if (
                    in_array(
                        'last_login_at',
                        $columns,
                        true
                    )
                ) {
                    $insert['last_login_at'] = now();
                }

                if (
                    in_array(
                        'remember_token',
                        $columns,
                        true
                    )
                ) {
                    $insert['remember_token'] = null;
                }

                $userId = (int) $db
                    ->table('site_users')
                    ->insertGetId($insert);

                $this->attachDefaultRegistrationRole(
                    $db,
                    $userId
                );
            }

            $request->session()->regenerate();

            $request->session()->put([
                'tenant_cms_authenticated' => true,

                'tenant_cms_user_id' =>
                    $userId,

                'tenant_cms_central_user_id' =>
                    $centralUserId > 0
                        ? $centralUserId
                        : null,

                'tenant_cms_authenticated_via' =>
                    'esubiz_sso',
            ]);

            return redirect()->to(
                $this->loginRedirect()
            );

        } catch (\Throwable $e) {
            report($e);

            return $this->loginError(
                'Esubiz authentication is temporarily unavailable.'
            );
        }
    }


    /**
     * Resolve this Core installation's existing Esubiz SSO
     * application without introducing another credential system.
     *
     * Hosted installations can resolve their Website application
     * directly from Central.
     *
     * Off-server installations use the same application payload
     * once it has been provisioned into the Core installation.
     */
    private function resolveEsubizApplication(): ?array
    {
        /*
         * Existing Central-hosted Website context.
         */
        try {
            if (
                class_exists(
                    \App\Models\Website::class
                )
                && class_exists(
                    \App\Services\Sso\SsoService::class
                )
            ) {
                $host = strtolower(
                    request()->getHost()
                );

                if (
                    str_ends_with(
                        $host,
                        '.esubiz.com'
                    )
                ) {
                    $subdomain = substr(
                        $host,
                        0,
                        -strlen('.esubiz.com')
                    );

                    if (
                        $subdomain !== ''
                        && !str_contains(
                            $subdomain,
                            '.'
                        )
                    ) {
                        $website =
                            \App\Models\Website::query()
                                ->where(
                                    'subdomain',
                                    $subdomain
                                )
                                ->where(
                                    'status',
                                    'active'
                                )
                                ->first();

                        if ($website) {
                            $application =
                                app(
                                    \App\Services\Sso\SsoService::class
                                )
                                ->findWebsiteApplication(
                                    (int) $website->id
                                );

                            if ($application) {
                                return [
                                    'client_id' =>
                                        (string)
                                        $application->client_id,

                                    'client_secret' =>
                                        (string)
                                        $application->client_secret,
                                ];
                            }
                        }
                    }
                }
            }
        } catch (\Throwable $e) {
            report($e);
        }

        /*
         * Off-server provisioning is deliberately not guessed here.
         *
         * The universal OAuth implementation is ready, while the
         * deployment/provisioning layer supplies this same application
         * identity independently of the authentication protocol.
         */
        return null;
    }


    public function googleRedirect(Request $request)
    {
        $credentials = $this->googleCredentials();

        if (
            !$credentials['client_id']
            || !$credentials['client_secret']
        ) {
            return back()->withErrors([
                'auth' => 'Google authentication is not configured.',
            ]);
        }

        $state = Str::random(64);

        $request->session()->put(
            'core_google_oauth_state',
            $state
        );

        $query = http_build_query([
            'client_id' => $credentials['client_id'],
            'redirect_uri' => request()->getSchemeAndHttpHost() . '/auth/google/callback',
            'response_type' => 'code',
            'scope' => 'openid email profile',
            'state' => $state,
            'prompt' => 'select_account',
        ]);

        return redirect()->away(
            'https://accounts.google.com/o/oauth2/v2/auth?' . $query
        );
    }


    public function googleCallback(Request $request)
    {
        $expected = (string) $request->session()->pull(
            'core_google_oauth_state',
            ''
        );

        $received = (string) $request->query(
            'state',
            ''
        );

        if (
            $expected === ''
            || $received === ''
            || !hash_equals($expected, $received)
        ) {
            return $this->loginError(
                'Google authentication session expired. Please try again.'
            );
        }

        $code = (string) $request->query(
            'code',
            ''
        );

        if ($code === '') {
            return $this->loginError(
                'Google authentication was cancelled.'
            );
        }

        $credentials = $this->googleCredentials();

        if (
            !$credentials['client_id']
            || !$credentials['client_secret']
        ) {
            return $this->loginError(
                'Google authentication is not configured.'
            );
        }

        $token = Http::asForm()
            ->timeout(15)
            ->post(
                'https://oauth2.googleapis.com/token',
                [
                    'code' => $code,
                    'client_id' => $credentials['client_id'],
                    'client_secret' => $credentials['client_secret'],
                    'redirect_uri' => request()->getSchemeAndHttpHost() . '/auth/google/callback',
                    'grant_type' => 'authorization_code',
                ]
            );

        if (!$token->successful()) {
            return $this->loginError(
                'Google authentication could not be completed.'
            );
        }

        $accessToken = (string) $token->json(
            'access_token',
            ''
        );

        if ($accessToken === '') {
            return $this->loginError(
                'Google did not return a valid access token.'
            );
        }

        $profile = Http::withToken($accessToken)
            ->acceptJson()
            ->timeout(15)
            ->get(
                'https://openidconnect.googleapis.com/v1/userinfo'
            );

        if (!$profile->successful()) {
            return $this->loginError(
                'Google profile information could not be retrieved.'
            );
        }

        $email = strtolower(
            trim(
                (string) $profile->json(
                    'email',
                    ''
                )
            )
        );

        $name = trim(
            (string) $profile->json(
                'name',
                ''
            )
        );

        $verified = filter_var(
            $profile->json(
                'email_verified',
                false
            ),
            FILTER_VALIDATE_BOOLEAN
        );

        if ($email === '' || !$verified) {
            return $this->loginError(
                'Google must provide a verified email address.'
            );
        }

        if (
            !Schema::connection('tenant')
                ->hasTable('site_users')
        ) {
            return $this->loginError(
                'Core user authentication is unavailable.'
            );
        }

        $db = DB::connection('tenant');

        $user = $db->table('site_users')
            ->whereRaw(
                'LOWER(email) = ?',
                [$email]
            )
            ->first();

        if (!$user) {
            $columns = Schema::connection('tenant')
                ->getColumnListing('site_users');

            $data = [];

            if (in_array('name', $columns, true)) {
                $data['name'] = $name !== ''
                    ? $name
                    : $email;
            }

            if (in_array('email', $columns, true)) {
                $data['email'] = $email;
            }

            if (in_array('password', $columns, true)) {
                $data['password'] = password_hash(
                    Str::random(64),
                    PASSWORD_BCRYPT
                );
            }

            if (in_array('created_at', $columns, true)) {
                $data['created_at'] = now();
            }

            if (in_array('updated_at', $columns, true)) {
                $data['updated_at'] = now();
            }

            $userId = $db->table('site_users')
                ->insertGetId($data);

            $this->attachDefaultRegistrationRole(
                $userId
            );

            $user = $db->table('site_users')
                ->where('id', $userId)
                ->first();
        }

        if (!$user) {
            return $this->loginError(
                'Google user authentication could not be completed.'
            );
        }

        $request->session()->regenerate();

        $request->session()->put(
            'tenant_cms_user_id',
            (int) $user->id
        );

        if (isset($user->email)) {
            $request->session()->put(
                'tenant_cms_user_email',
                (string) $user->email
            );
        }

        return redirect()->to(
            $this->loginRedirect()
        );
    }


    private function googleCredentials(): array
    {
        /*
         * Read only existing Core Authentication settings.
         * Nothing is written here.
         */
        $settings = $this->authSettings();

        $first = static function (
            array $settings,
            array $keys
        ) {
            foreach ($keys as $key) {
                if (
                    array_key_exists($key, $settings)
                    && trim((string) $settings[$key]) !== ''
                ) {
                    return trim(
                        (string) $settings[$key]
                    );
                }
            }

            return null;
        };

        return [
            'client_id' => $first(
                $settings,
                [
                    'auth.google.client_id',
                    'auth.google_client_id',
                    'google_client_id',
                ]
            ),

            'client_secret' => $first(
                $settings,
                [
                    'auth.google.client_secret',
                    'auth.google_client_secret',
                    'google_client_secret',
                ]
            ),
        ];
    }


    private function authSettings(): array
    {
        /*
         * Existing Core code may use site_settings or settings.
         * Read whichever existing tenant table contains the
         * Authentication Settings keys. Do not create either.
         */
        foreach (
            ['site_settings', 'settings']
            as $table
        ) {
            if (
                !Schema::connection('tenant')
                    ->hasTable($table)
            ) {
                continue;
            }

            $columns = Schema::connection('tenant')
                ->getColumnListing($table);

            $keyColumn = in_array(
                'key',
                $columns,
                true
            )
                ? 'key'
                : (
                    in_array(
                        'name',
                        $columns,
                        true
                    )
                        ? 'name'
                        : null
                );

            $valueColumn = in_array(
                'value',
                $columns,
                true
            )
                ? 'value'
                : null;

            if (!$keyColumn || !$valueColumn) {
                continue;
            }

            return DB::connection('tenant')
                ->table($table)
                ->pluck(
                    $valueColumn,
                    $keyColumn
                )
                ->all();
        }

        return [];
    }


    private function registrationConfig(): array
    {
        return $this->authFormConfig(
            'registration'
        );
    }


    private function loginRedirect(): string
    {
        $config = $this->authFormConfig(
            'login'
        );

        $redirect = trim(
            (string) (
                $config['redirect']
                ?? ''
            )
        );

        if (
            $redirect !== ''
            && str_starts_with(
                $redirect,
                '/'
            )
            && !str_starts_with(
                $redirect,
                '//'
            )
        ) {
            return $redirect;
        }

        return '/admin/dashboard';
    }


    private function authFormConfig(
        string $purpose
    ): array {
        if (
            !Schema::connection('tenant')
                ->hasTable('forms')
        ) {
            return [];
        }

        $forms = DB::connection('tenant')
            ->table('forms')
            ->orderBy('id')
            ->get();

        $fallback = null;

        foreach ($forms as $form) {
            $settings = json_decode(
                (string) (
                    $form->settings
                    ?? ''
                ),
                true
            );

            $settings = is_array($settings)
                ? $settings
                : [];

            if (
                ($settings['core_default_form'] ?? null)
                === $purpose
            ) {
                $config = $settings['auth_config']
                    ?? [];

                return is_array($config)
                    ? $config
                    : [];
            }

            if (
                ($settings['purpose'] ?? null)
                === 'authentication.' . $purpose
            ) {
                $fallback = $settings;
            }
        }

        if (!$fallback) {
            return [];
        }

        $config = $fallback['auth_config']
            ?? [];

        return is_array($config)
            ? $config
            : [];
    }


    private function attachDefaultRegistrationRole(
        int $userId
    ): void {
        $config = $this->registrationConfig();

        $roleId = filter_var(
            $config['role_id'] ?? null,
            FILTER_VALIDATE_INT
        );

        if (
            !$roleId
            || !Schema::connection('tenant')
                ->hasTable('site_roles')
            || !Schema::connection('tenant')
                ->hasTable('site_user_roles')
        ) {
            return;
        }

        $db = DB::connection('tenant');

        if (
            !$db->table('site_roles')
                ->where('id', $roleId)
                ->exists()
        ) {
            return;
        }

        $exists = $db->table('site_user_roles')
            ->where('user_id', $userId)
            ->where('role_id', $roleId)
            ->exists();

        if ($exists) {
            return;
        }

        $columns = Schema::connection('tenant')
            ->getColumnListing(
                'site_user_roles'
            );

        $data = [
            'user_id' => $userId,
            'role_id' => $roleId,
        ];

        if (in_array('created_at', $columns, true)) {
            $data['created_at'] = now();
        }

        if (in_array('updated_at', $columns, true)) {
            $data['updated_at'] = now();
        }

        $db->table('site_user_roles')
            ->insert($data);
    }


    private function loginError(
        string $message
    ) {
        return redirect()
            ->to('/login')
            ->withErrors([
                'auth' => $message,
            ]);
    }
}
