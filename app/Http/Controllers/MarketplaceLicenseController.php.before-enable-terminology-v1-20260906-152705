<?php

namespace App\Http\Controllers;

use App\Services\Marketplace\Licensing\MarketplaceLicenseService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use RuntimeException;
use Throwable;

/**
 * ESUBIZ_MARKETPLACE_LICENSE_VALIDATION_API_V1
 *
 * Central Esubiz is the authoritative license validator.
 *
 * Used by:
 *
 * 1. Off-server Core automatic Marketplace fulfilment.
 * 2. Off-server Core manual ZIP installation License Validation box.
 *
 * This endpoint never reveals another customer's human-readable
 * license key. It only validates a license supplied by Core.
 */
class MarketplaceLicenseController extends Controller
{
    public function validateLicense(
        Request $request,
        MarketplaceLicenseService $licenses
    ): JsonResponse {
        $validated = $request->validate([
            'license_key' => [
                'required',
                'string',
                'max:191',
            ],

            'core_instance_uuid' => [
                'required',
                'uuid',
            ],

            'product_type' => [
                'required',
                'string',
                'max:64',
            ],

            'product_id' => [
                'required',
                'integer',
                'min:1',
            ],

            'product_slug' => [
                'nullable',
                'string',
                'max:191',
            ],

            'product_version' => [
                'nullable',
                'string',
                'max:64',
            ],

            'domain' => [
                'nullable',
                'string',
                'max:255',
            ],

            'installation_fingerprint' => [
                'nullable',
                'string',
                'max:128',
            ],

            'core_version' => [
                'nullable',
                'string',
                'max:64',
            ],
        ]);

        try {
            /*
             * First validate the supplied real license and bind/revalidate
             * it against this standalone Core installation.
             */
            $result = $licenses->validateAndActivate(
                $validated['license_key'],
                $validated['core_instance_uuid'],
                [
                    'domain' =>
                        $validated['domain']
                            ?? null,

                    'installation_fingerprint' =>
                        $validated[
                            'installation_fingerprint'
                        ]
                            ?? null,

                    'core_version' =>
                        $validated['core_version']
                            ?? null,

                    'metadata' => [
                        'validation_source' =>
                            'core_marketplace',

                        'ip' =>
                            $request->ip(),
                    ],
                ]
            );

            /*
             * Product binding is mandatory.
             *
             * A genuine license for Product A must never authorize
             * Product B just because the key itself is otherwise valid.
             */
            if (
                (string) (
                    $result['product_type']
                    ?? ''
                )
                !==
                (string) $validated[
                    'product_type'
                ]
            ) {
                throw new RuntimeException(
                    'License is not valid for this Marketplace product type.'
                );
            }

            if (
                (int) (
                    $result['product_id']
                    ?? 0
                )
                !==
                (int) $validated[
                    'product_id'
                ]
            ) {
                throw new RuntimeException(
                    'License is not valid for this Marketplace product.'
                );
            }

            /*
             * Where the installer supplies package slug/version,
             * verify those too.
             */
            if (
                !empty(
                    $validated['product_slug']
                )
                &&
                !empty(
                    $result['product_slug']
                )
                &&
                (string) $validated[
                    'product_slug'
                ]
                !==
                (string) $result[
                    'product_slug'
                ]
            ) {
                throw new RuntimeException(
                    'License does not match this product package.'
                );
            }

            if (
                !empty(
                    $validated[
                        'product_version'
                    ]
                )
                &&
                !empty(
                    $result[
                        'product_version'
                    ]
                )
                &&
                (string) $validated[
                    'product_version'
                ]
                !==
                (string) $result[
                    'product_version'
                ]
            ) {
                throw new RuntimeException(
                    'License does not match this product version.'
                );
            }

            return response()->json([
                'ok' => true,
                'valid' => true,

                'license' => [
                    'reference' =>
                        $result[
                            'license_reference'
                        ]
                            ?? null,

                    'uuid' =>
                        $result[
                            'license_uuid'
                        ]
                            ?? null,

                    'expires_at' =>
                        $result[
                            'expires_at'
                        ]
                            ?? null,
                ],

                'entitlement' => [
                    'uuid' =>
                        $result[
                            'entitlement_uuid'
                        ]
                            ?? null,

                    'product_type' =>
                        $result[
                            'product_type'
                        ],

                    'product_id' =>
                        $result[
                            'product_id'
                        ],

                    'product_slug' =>
                        $result[
                            'product_slug'
                        ]
                            ?? null,

                    'product_version' =>
                        $result[
                            'product_version'
                        ]
                            ?? null,

                    'deployment' =>
                        $result[
                            'deployment'
                        ],

                    'capabilities' =>
                        $result[
                            'capabilities'
                        ]
                            ?? [],
                ],

                'activation' => [
                    'core_instance_uuid' =>
                        $result[
                            'core_instance_uuid'
                        ],
                ],
            ]);
        } catch (RuntimeException $e) {
            return response()->json([
                'ok' => false,
                'valid' => false,
                'message' => $e->getMessage(),
            ], 422);
        } catch (Throwable $e) {
            report($e);

            return response()->json([
                'ok' => false,
                'valid' => false,
                'message' =>
                    'Marketplace license validation failed.',
            ], 500);
        }
    }
}
