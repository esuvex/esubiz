<?php

namespace App\Services\Website;

use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

/**
 * ESUBIZ_MULTI_AUTH_FORMS_FOUNDATION_V1
 *
 * Generic Core authentication-form registry.
 *
 * A Core website may expose multiple authentication portals/forms.
 * Each form may independently support login, registration, or both.
 *
 * The existing Core authentication settings remain authoritative for
 * the Default form while the multi-form architecture is introduced.
 *
 * Works through the active tenant connection and therefore remains
 * portable between SaaS and off-server Core deployments.
 */
class TenantAuthFormService
{
    public const REGISTRY_KEY = 'auth.forms';

    public const DEFAULT_FORM_ID = 'default';


    /**
     * Return every configured auth form.
     */
    public function all(): array
    {
        $forms = $this->readJsonSetting(
            self::REGISTRY_KEY,
            []
        );

        if (!is_array($forms)) {
            $forms = [];
        }

        $forms = $this->normalizeForms($forms);

        if (!isset($forms[self::DEFAULT_FORM_ID])) {
            $forms[self::DEFAULT_FORM_ID] =
                $this->buildDefaultForm();
        }

        return $forms;
    }


    /**
     * Resolve one auth form by ID or slug.
     */
    public function find(?string $identifier): ?array
    {
        $identifier = trim(
            (string) $identifier
        );

        if ($identifier === '') {
            $identifier =
                self::DEFAULT_FORM_ID;
        }

        $forms = $this->all();

        if (isset($forms[$identifier])) {
            return $forms[$identifier];
        }

        foreach ($forms as $form) {

            if (
                ($form['slug'] ?? null)
                === $identifier
            ) {
                return $form;
            }
        }

        return null;
    }


    /**
     * Default form.
     */
    public function default(): array
    {
        return $this->find(
            self::DEFAULT_FORM_ID
        ) ?? $this->buildDefaultForm();
    }


    /**
     * Persist complete registry.
     *
     * Future form-management UI should use this instead of
     * writing directly to site_settings.
     */
    public function saveAll(array $forms): array
    {
        $forms =
            $this->normalizeForms($forms);

        if (!isset($forms[self::DEFAULT_FORM_ID])) {
            $forms[self::DEFAULT_FORM_ID] =
                $this->buildDefaultForm();
        }

        $this->writeJsonSetting(
            self::REGISTRY_KEY,
            $forms
        );

        return $forms;
    }


    /**
     * Create/update one form.
     */
    public function save(array $form): array
    {
        $forms = $this->all();

        $normalized =
            $this->normalizeForm(
                $form,
                $form['id'] ?? null
            );

        $forms[$normalized['id']] =
            $normalized;

        return $this->saveAll($forms);
    }


    /**
     * Create a new generic auth form.
     */
    public function create(
        string $name,
        string $mode = 'both'
    ): array {
        $name = trim($name);

        if ($name === '') {
            throw new \InvalidArgumentException(
                'Auth form name is required.'
            );
        }

        $slug = Str::slug($name);

        if ($slug === '') {
            $slug = 'auth-form';
        }

        $forms = $this->all();

        $baseSlug = $slug;
        $suffix = 2;

        while (
            collect($forms)->contains(
                fn ($form) =>
                    ($form['slug'] ?? null)
                    === $slug
            )
        ) {
            $slug =
                $baseSlug
                . '-'
                . $suffix;

            $suffix++;
        }

        $id = (string) Str::uuid();

        $form = $this->normalizeForm(
            [
                'id' => $id,
                'name' => $name,
                'slug' => $slug,
                'mode' => $mode,
                'is_default' => false,
                'enabled' => true,
                'login' => [],
                'registration' => [],
                'providers' => [],
                'security' => [],
                'branding' => [],
                'fields' => [],

                /*
                 * ESUBIZ_AUTH_FORM_REGISTRATION_COMMERCE_EXTENSIBILITY_V1
                 *
                 * Generic registration offers.
                 *
                 * Core, website types, themes and modules may expose
                 * registration-time products/plans/memberships/services
                 * through provider/resolver contracts.
                 *
                 * Auth Forms store only portable references/configuration.
                 * They do not own product tables or payment gateways.
                 */
                'offers' => [
                    'enabled' => false,
                    'selection_mode' => 'optional',
                    'items' => [],
                ],

                /*
                 * Registration payment policy.
                 *
                 * "site" means payment is resolved through the website's
                 * configured gateway/payment layer at runtime.
                 *
                 * No domain/subdomain or Central URL is stored here.
                 */
                'payment' => [
                    'enabled' => false,
                    'gateway_mode' => 'site',
                    'allowed_gateways' => [],
                    'require_payment_before_activation' => true,
                ],

                /*
                 * Extension-owned form configuration.
                 *
                 * Modules can safely attach namespaced registration
                 * configuration without modifying the Core schema.
                 */
                'extensions' => [],
            ],
            $id
        );

        $forms[$id] = $form;

        $this->saveAll($forms);

        return $form;
    }


    /**
     * Delete a non-default form.
     */
    public function delete(string $id): bool
    {
        if ($id === self::DEFAULT_FORM_ID) {
            return false;
        }

        $forms = $this->all();

        if (!isset($forms[$id])) {
            return false;
        }

        unset($forms[$id]);

        $this->saveAll($forms);

        return true;
    }


    /**
     * Build Default form from CURRENT Core auth settings.
     *
     * This is the compatibility bridge. Nothing currently working
     * on /login or /register needs to change yet.
     */
    public function buildDefaultForm(): array
    {
        $registrationFields =
            $this->readJsonSetting(
                'auth.registration_fields',
                []
            );

        if (!is_array($registrationFields)) {
            $registrationFields = [];
        }

        $providerOrder =
            $this->readJsonSetting(
                'auth.provider_order',
                [
                    'esubiz',
                    'google',
                    'facebook',
                    'instagram',
                    'tiktok',
                    'x',
                ]
            );

        if (!is_array($providerOrder)) {
            $providerOrder = [];
        }

        return $this->normalizeForm(
            [
                'id' => self::DEFAULT_FORM_ID,

                'name' => 'Default',

                'slug' => 'default',

                'mode' => 'both',

                'is_default' => true,

                'enabled' => true,


                /*
                 * LOGIN
                 */
                'login' => [
                    'enabled' =>
                        $this->readBooleanSetting(
                            'auth.security.login_enabled',
                            true
                        ),

                    'heading' =>
                        $this->readSetting(
                            'auth.login.heading',
                            'Welcome back'
                        ),

                    'subheading' =>
                        $this->readSetting(
                            'auth.login.subheading',
                            'Sign in to continue'
                        ),

                    'redirect' =>
                        $this->readSetting(
                            'auth.login_redirect',
                            '/admin/dashboard'
                        ),
                ],


                /*
                 * REGISTRATION
                 */
                'registration' => [
                    'enabled' =>
                        $this->readBooleanSetting(
                            'auth.registration_enabled',
                            true
                        ),

                    'heading' =>
                        $this->readSetting(
                            'auth.register.heading',
                            'Create your account'
                        ),

                    'subheading' =>
                        $this->readSetting(
                            'auth.register.subheading',
                            'Register to continue'
                        ),

                    'auto_login' =>
                        $this->readBooleanSetting(
                            'auth.registration_auto_login',
                            true
                        ),

                    'redirect' =>
                        $this->readSetting(
                            'auth.registration_redirect',
                            '/admin/dashboard'
                        ),

                    /*
                     * These become authoritative when their
                     * runtime workflows are connected.
                     */
                    'require_email_verification' => false,

                    'default_role' => null,
                ],


                /*
                 * PROVIDERS
                 *
                 * Provider credentials remain in their existing
                 * protected site_settings keys. Forms only select
                 * which configured providers they allow.
                 */
                'providers' => [
                    'order' =>
                        array_values(
                            $providerOrder
                        ),

                    'enabled' => [
                        'esubiz' =>
                            $this->readBooleanSetting(
                                'auth.provider.esubiz.enabled',
                                true
                            ),

                        'google' =>
                            $this->readBooleanSetting(
                                'auth.provider.google.enabled',
                                false
                            ),

                        'facebook' =>
                            $this->readBooleanSetting(
                                'auth.provider.facebook.enabled',
                                false
                            ),

                        'instagram' =>
                            $this->readBooleanSetting(
                                'auth.provider.instagram.enabled',
                                false
                            ),

                        'tiktok' =>
                            $this->readBooleanSetting(
                                'auth.provider.tiktok.enabled',
                                false
                            ),

                        'x' =>
                            $this->readBooleanSetting(
                                'auth.provider.x.enabled',
                                false
                            ),
                    ],
                ],


                /*
                 * SECURITY
                 */
                'security' => [
                    'login_protection' =>
                        $this->readBooleanSetting(
                            'auth.security.login_enabled',
                            true
                        ),

                    'rate_limiting' => true,

                    /*
                     * Runtime email verification will be wired
                     * separately instead of pretending it exists.
                     */
                    'enforce_email_verification' => false,
                ],


                /*
                 * BRANDING
                 *
                 * Current shared auth branding remains the
                 * Default form's fallback.
                 */
                'branding' => [
                    'inherit_shared' => true,
                ],


                /*
                 * ORDERED FIELD DEFINITIONS
                 *
                 * Array order becomes the canonical drag/drop
                 * display order.
                 */
                'fields' =>
                    array_values(
                        $registrationFields
                    ),

                /*
                 * Registration commerce is disabled by default so the
                 * existing Default form keeps its current behaviour.
                 *
                 * Offers are resolved later from registered providers;
                 * they are never hardcoded to Membership/Ecommerce/etc.
                 */
                'offers' => [
                    'enabled' => false,
                    'selection_mode' => 'optional',
                    'items' => [],
                ],

                'payment' => [
                    'enabled' => false,
                    'gateway_mode' => 'site',
                    'allowed_gateways' => [],
                    'require_payment_before_activation' => true,
                ],

                'extensions' => [],
            ],
            self::DEFAULT_FORM_ID
        );
    }


    /**
     * Normalize registry.
     */
    protected function normalizeForms(
        array $forms
    ): array {
        $normalized = [];

        foreach ($forms as $key => $form) {

            if (!is_array($form)) {
                continue;
            }

            $normalizedForm =
                $this->normalizeForm(
                    $form,
                    is_string($key)
                        ? $key
                        : null
                );

            $normalized[
                $normalizedForm['id']
            ] = $normalizedForm;
        }

        return $normalized;
    }


    /**
     * Normalize one form.
     */
    protected function normalizeForm(
        array $form,
        ?string $fallbackId = null
    ): array {
        $id = trim(
            (string) (
                $form['id']
                ?? $fallbackId
                ?? ''
            )
        );

        if ($id === '') {
            $id = (string) Str::uuid();
        }

        $name = trim(
            (string) (
                $form['name']
                ?? 'Auth Form'
            )
        );

        if ($name === '') {
            $name = 'Auth Form';
        }

        $slug = Str::slug(
            (string) (
                $form['slug']
                ?? $name
            )
        );

        if ($slug === '') {
            $slug = $id;
        }

        $mode = strtolower(
            (string) (
                $form['mode']
                ?? 'both'
            )
        );

        if (
            !in_array(
                $mode,
                [
                    'login',
                    'registration',
                    'both',
                ],
                true
            )
        ) {
            $mode = 'both';
        }

        return [
            'id' => $id,

            'name' => $name,

            'slug' =>
                $id === self::DEFAULT_FORM_ID
                ? 'default'
                : $slug,

            'mode' => $mode,

            'is_default' =>
                $id === self::DEFAULT_FORM_ID,

            'enabled' =>
                array_key_exists(
                    'enabled',
                    $form
                )
                ? (bool) $form['enabled']
                : true,

            'login' =>
                is_array(
                    $form['login']
                    ?? null
                )
                ? $form['login']
                : [],

            'registration' =>
                is_array(
                    $form['registration']
                    ?? null
                )
                ? $form['registration']
                : [],

            'providers' =>
                is_array(
                    $form['providers']
                    ?? null
                )
                ? $form['providers']
                : [],

            'security' =>
                is_array(
                    $form['security']
                    ?? null
                )
                ? $form['security']
                : [],

            'branding' =>
                is_array(
                    $form['branding']
                    ?? null
                )
                ? $form['branding']
                : [],

            'fields' =>
                array_values(
                    is_array(
                        $form['fields']
                        ?? null
                    )
                    ? $form['fields']
                    : []
                ),

            /*
             * ESUBIZ_AUTH_FORM_REGISTRATION_COMMERCE_EXTENSIBILITY_V1
             *
             * Portable offer references supplied by registered
             * Core/module/theme/website-type providers.
             */
            'offers' => [
                'enabled' =>
                    (bool) (
                        $form['offers']['enabled']
                        ?? false
                    ),

                'selection_mode' =>
                    in_array(
                        ($form['offers']['selection_mode'] ?? 'optional'),
                        ['optional', 'required', 'single', 'multiple'],
                        true
                    )
                    ? $form['offers']['selection_mode']
                    : 'optional',

                'items' =>
                    array_values(
                        is_array(
                            $form['offers']['items']
                            ?? null
                        )
                        ? $form['offers']['items']
                        : []
                    ),
            ],

            /*
             * Payment is intentionally resolved through the site's
             * payment/gateway layer. This configuration never contains
             * a hardcoded SaaS hostname or off-server hostname.
             */
            'payment' => [
                'enabled' =>
                    (bool) (
                        $form['payment']['enabled']
                        ?? false
                    ),

                'gateway_mode' => 'site',

                'allowed_gateways' =>
                    array_values(
                        is_array(
                            $form['payment']['allowed_gateways']
                            ?? null
                        )
                        ? $form['payment']['allowed_gateways']
                        : []
                    ),

                'require_payment_before_activation' =>
                    array_key_exists(
                        'require_payment_before_activation',
                        $form['payment'] ?? []
                    )
                    ? (bool) $form['payment']['require_payment_before_activation']
                    : true,
            ],

            /*
             * Namespaced extension data.
             * Example:
             *
             * extensions.membership.*
             * extensions.school.*
             * extensions.vendor.*
             *
             * Core does not need to know those module schemas.
             */
            'extensions' =>
                is_array(
                    $form['extensions']
                    ?? null
                )
                ? $form['extensions']
                : [],
        ];
    }


    /**
     * Persist current Default form snapshot into the registry.
     *
     * Safe to run repeatedly. Once the registry already exists,
     * it does not overwrite it.
     */
    public function migrateCurrentDefault(): array
    {
        $existing =
            $this->readJsonSetting(
                self::REGISTRY_KEY,
                null
            );

        if (
            is_array($existing)
            &&
            !empty($existing)
        ) {
            return $this->all();
        }

        $forms = [
            self::DEFAULT_FORM_ID =>
                $this->buildDefaultForm(),
        ];

        $this->writeJsonSetting(
            self::REGISTRY_KEY,
            $forms
        );

        return $forms;
    }


    protected function readSetting(
        string $key,
        mixed $default = null
    ): mixed {
        $value = DB::connection('tenant')
            ->table('site_settings')
            ->where('key', $key)
            ->value('value');

        return $value !== null
            ? $value
            : $default;
    }


    protected function readBooleanSetting(
        string $key,
        bool $default = false
    ): bool {
        $value =
            $this->readSetting(
                $key,
                null
            );

        if ($value === null) {
            return $default;
        }

        return filter_var(
            $value,
            FILTER_VALIDATE_BOOLEAN
        );
    }


    protected function readJsonSetting(
        string $key,
        mixed $default = []
    ): mixed {
        $value =
            $this->readSetting(
                $key,
                null
            );

        if ($value === null || $value === '') {
            return $default;
        }

        if (is_array($value)) {
            return $value;
        }

        $decoded =
            json_decode(
                (string) $value,
                true
            );

        return json_last_error() === JSON_ERROR_NONE
            ? $decoded
            : $default;
    }


    protected function writeJsonSetting(
        string $key,
        array $value
    ): void {
        DB::connection('tenant')
            ->table('site_settings')
            ->updateOrInsert(
                [
                    'key' => $key,
                ],
                [
                    'value' =>
                        json_encode(
                            $value,
                            JSON_UNESCAPED_SLASHES
                            | JSON_UNESCAPED_UNICODE
                        ),
                ]
            );
    }
}
