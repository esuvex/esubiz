                                [
                                    /*
                                     * Existing Form widget compatibility.
                                     */
                                    'formId' =>
                                        '',

                                    /*
                                     * Future deferred resource binding.
                                     */
                                    'form_id' =>
                                        null,

                                    'form_key' =>
                                        'contact-form',

                                    'form_name' =>
                                        'Contact Form',

                                    'binding' =>
