    justify-content:space-between;
    gap:15px;
    padding:14px 15px;
    border:1px solid var(--line);
    border-radius:14px;
    background:#fff;
}

.check .left{
    display:flex;
    align-items:center;
    gap:11px;
}

.icon{
    width:30px;
    height:30px;
    border-radius:50%;
    display:grid;
