        if (empty($path)) {
            return null;
        }

        return request()->getSchemeAndHttpHost()
            . '/media/'
            . implode(
                '/',
                array_map(
                    'rawurlencode',
                    explode(
                        '/',
                        ltrim($path, '/')
                    )
                )
            );
    };


    $floatingDevices =
        static function (
            ?string $value
        ): array {
            return array_values(
                array_filter(
                    array_map(
                        'trim',
                        explode(
                            ',',
                            (string) $value
                        )
                    )
                )
            );
        };

    $whatsappDevices =
        $floatingDevices(
            $theme['whatsapp_devices']
