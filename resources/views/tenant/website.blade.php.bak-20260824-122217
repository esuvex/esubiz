<script>

function initEsubizHeroSliders() {

    document
        .querySelectorAll(
            '.esubiz-hero-slider'
        )
        .forEach(
            function (slider) {

                const slides =
                    Array.from(
                        slider.querySelectorAll(
                            '.esubiz-hero-slide'
                        )
                    );

                if (slides.length <= 1) {
                    return;
                }

                if (
                    slider.dataset.autoplay
                    !== '1'
                ) {
                    return;
                }

                let current = 0;

                const interval =
                    Math.max(
                        2000,
                        Number(
                            slider.dataset.interval
                            || 5000
                        )
                    );


                window.setInterval(
                    function () {

                        slides[current]
                            .classList.remove(
                                'is-active'
                            );

                        current =
                            (
                                current + 1
                            )
                            % slides.length;

                        slides[current]
                            .classList.add(
                                'is-active'
                            );

                    },
                    interval
                );

            }
        );

}


document.addEventListener(
    'DOMContentLoaded',
    initEsubizHeroSliders
);

</script>

