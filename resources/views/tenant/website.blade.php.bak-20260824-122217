    /*
     * =========================================================
     * CORE PAGE BUILDER RENDERER
     * =========================================================
     */

    $coreBuilderBlocks =
        is_array($builderContent ?? null)
            ? $builderContent
            : [];


    $imageWidths = [
        'thumbnail' => '150px',
        'small' => '320px',
        'medium' => '640px',
        'large' => '960px',
        'very_large' => '1280px',
    ];


    $renderWidget = function ($widget) use (
        &$renderWidget,
        $imageWidths
    ) {

        $widget =
            is_array($widget)
                ? $widget
                : [];

        $type =
            $widget['type'] ?? '';


        /*
         * HERO / SLIDER
         */
        if ($type === 'hero') {

            $slides =
                is_array(
                    $widget['slides']
                    ?? null
                )
                    ? $widget['slides']
                    : [];

            if (!$slides) {
                return '';
            }

            $autoplay =
                ($widget['autoplay'] ?? true)
                    ? '1'
                    : '0';

            $interval =
                max(
                    2000,
                    min(
                        15000,
                        (int) (
                            $widget['interval']
                            ?? 5000
                        )
                    )
                );

            $height =
                max(
                    300,
                    min(
                        900,
                        (int) (
                            $widget['height']
                            ?? 520
                        )
                    )
                );

            $html =
                '<div class="esubiz-hero-slider"'
                . ' data-autoplay="'
                . $autoplay
                . '"'
                . ' data-interval="'
                . $interval
                . '"'
                . ' style="min-height:'
                . $height
                . 'px">';


            foreach (
                $slides
                as $index => $slide
            ) {

                $slide =
                    is_array($slide)
                        ? $slide
                        : [];

                $background =
                    '';

                $slideImage = '';

                if (!empty($slide['uploaded_path'])) {

                    $slideImage = asset(
                        'storage/'
                        . ltrim(
                            $slide['uploaded_path'],
                            '/'
                        )
                    );

                } elseif (!empty($slide['image'])) {

                    $slideImage =
                        $slide['image'];
                }


                if ($slideImage !== '') {

                    $background =
                        ' style="background-image:'
                        . 'linear-gradient('
                        . 'rgba(15,23,42,.48),'
                        . 'rgba(15,23,42,.48)'
                        . '),url(\''
                        . e($slideImage)
                        . '\')"';
                }


                $html .=
                    '<div class="esubiz-hero-slide'
                    . (
                        $index === 0
                            ? ' is-active'
                            : ''
                    )
                    . '"'
                    . $background
                    . '>';


                $html .=
                    '<div class="esubiz-hero-content">';


                if (
                    !empty(
                        $slide['heading']
                    )
                ) {

                    $html .=
                        '<h1>'
                        . e(
                            $slide['heading']
                        )
                        . '</h1>';
                }


                if (
                    !empty(
                        $slide['text']
                    )
                ) {

                    $html .=
                        '<p>'
                        . nl2br(
                            e(
                                $slide['text']
                            )
                        )
                        . '</p>';
                }


                if (
                    !empty(
                        $slide['button_text']
                    )
                ) {

                    $html .=
                        '<a class="esubiz-widget-button" href="'
                        . e(
                            $slide['button_url']
                            ?? '#'
                        )
                        . '">'
                        . e(
                            $slide['button_text']
                        )
                        . '</a>';
                }


                $html .=
                    '</div></div>';
            }


            $html .= '</div>';

            return $html;
        }


        /*
         * HEADING
         */
        if ($type === 'heading') {

            $level =
                in_array(
                    $widget['level'] ?? 'h2',
                    ['h1', 'h2', 'h3'],
                    true
                )
                    ? $widget['level']
                    : 'h2';

            return '<'
                . $level
                . ' class="esubiz-widget-heading">'
                . e($widget['text'] ?? '')
                . '</'
                . $level
                . '>';
        }


        /*
         * TEXT
         */
        if ($type === 'text') {

            return '<div class="esubiz-widget-text">'
                . nl2br(
                    e(
                        $widget['text'] ?? ''
                    )
                )
                . '</div>';
        }


        /*
         * BUTTON
         */
        if ($type === 'button') {

            return '<div class="esubiz-widget-button-wrap">'
                . '<a class="esubiz-widget-button" href="'
                . e($widget['url'] ?? '#')
                . '">'
                . e($widget['text'] ?? 'Learn More')
                . '</a>'
                . '</div>';
        }


        /*
         * IMAGE
         */
        if ($type === 'image') {

            /*
             * Tenant-uploaded media is stored against the website's
             * Core storage allocation. Prefer the stored public path
             * so public rendering does not depend on a temporary URL.
             */
            if (!empty($widget['uploaded_path'])) {

                $url = asset(
                    'storage/'
                    . ltrim(
                        $widget['uploaded_path'],
                        '/'
                    )
                );

            } else {

                $url =
                    $widget['url']
                    ?? '';
            }

            if ($url === '') {
                return '';
            }

            $size =
                $widget['size'] ?? 'large';

            if ($size === 'custom') {

                $custom =
                    max(
                        1,
                        (int) (
                            $widget['custom_width']
                            ?? 800
                        )
                    );

                $width =
                    $custom . 'px';

            } else {

                $width =
                    $imageWidths[$size]
                    ?? $imageWidths['large'];
            }

            return '<img'
                . ' class="esubiz-widget-image"'
                . ' src="' . e($url) . '"'
                . ' alt="' . e($widget['alt'] ?? '') . '"'
                . ' style="width:min(100%,'
                . e($width)
                . ');"'
                . '>';
        }


        /*
         * DIVIDER
         */
        if ($type === 'divider') {

            return '<hr class="esubiz-widget-divider">';
        }


        /*
         * SPACER
         */
        if ($type === 'spacer') {

            $height =
                max(
                    10,
                    min(
                        200,
                        (int) (
                            $widget['height']
                            ?? 40
                        )
                    )
                );

            return '<div style="height:'
                . $height
                . 'px"></div>';
        }


        /*
         * FORM
         *
         * Real form rendering will replace this when Core Forms
         * is connected.
         */
        if ($type === 'form') {

            if (empty($widget['form_id'])) {
                return '';
            }

            return '<div'
                . ' class="esubiz-form-placeholder"'
                . ' data-esubiz-form-id="'
                . e($widget['form_id'])
                . '"'
                . '>Website Form</div>';
        }


        return '';
    };


    $renderBlock = function ($block) use (
        &$renderBlock,
        &$renderWidget
    ) {

        $block =
            is_array($block)
                ? $block
                : [];


        /*
         * Old standalone Core widgets.
         */
        if (
            ($block['type'] ?? '')
            !== 'section'
        ) {
            return $renderWidget(
                $block
            );
        }


        /*
         * SECTION COLUMN RATIO
         */
        $ratio =
            $block['ratio'] ?? '1';

        $ratioParts =
            array_values(
                array_filter(
                    array_map(
                        function ($part) {

                            return max(
                                1,
                                (int) $part
                            );

                        },
                        explode(
                            ':',
                            $ratio
                        )
                    )
                )
            );

        if (!$ratioParts) {
            $ratioParts = [1];
        }

        $grid =
            implode(
                ' ',
                array_map(
                    fn ($part) =>
                        $part . 'fr',
                    $ratioParts
                )
            );


        $html =
            '<section class="esubiz-builder-section">'
            . '<div class="esubiz-builder-section-inner">';


        /*
         * Optional section heading.
         */
        if (
            !empty(
                $block['heading']
            )
        ) {

            $html .=
                '<h2 class="esubiz-section-heading">'
                . e($block['heading'])
                . '</h2>';
        }


        $html .=
            '<div'
            . ' class="esubiz-section-grid"'
            . ' style="grid-template-columns:'
            . e($grid)
            . ';">';


        foreach (
            ($block['columns'] ?? [])
            as $column
        ) {

            $html .=
                '<div class="esubiz-section-column">';


            foreach (
                ($column['widgets'] ?? [])
                as $widget
            ) {

                $html .=
                    $renderWidget(
                        $widget
                    );
            }


            $html .= '</div>';
        }


        $html .=
            '</div>'
            . '</div>'
            . '</section>';


        return $html;
    };

