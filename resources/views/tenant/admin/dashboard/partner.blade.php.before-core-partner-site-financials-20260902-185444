@php
    /*
    |--------------------------------------------------------------------------
    | ESUBIZ_CORE_PREMIUM_PARTNER_DASHBOARD_V1
    |--------------------------------------------------------------------------
    |
    | All values below come from the Partner ledger and investment
    | configuration already supplied by TenantCmsController.
    |
    | No financial values are fabricated in this view.
    |
    */

    $credits = (float) (
        $partnerLedgerTotals['credits'] ?? 0
    );

    $debits = (float) (
        $partnerLedgerTotals['debits'] ?? 0
    );

    $balance = (float) (
        $partnerLedgerTotals['balance'] ?? 0
    );

    $ledgerVolume = $credits + $debits;

    $creditPercentage = $ledgerVolume > 0
        ? round(($credits / $ledgerVolume) * 100, 2)
        : 0;

    $debitPercentage = $ledgerVolume > 0
        ? round(($debits / $ledgerVolume) * 100, 2)
        : 0;

    $investmentPercentage = $partnerInvestment
        ? min(
            100,
            max(
                0,
                (float)
                $partnerInvestment->investment_percentage
            )
        )
        : 0;

    $remainingPercentage = max(
        0,
        100 - $investmentPercentage
    );

    $profitBasis = $partnerInvestment
        ? strtolower(
            (string) $partnerInvestment->profit_basis
        )
        : null;

    $balanceIsPositive = $balance > 0;
    $balanceIsNegative = $balance < 0;

    $balanceLabel = $balanceIsPositive
        ? 'Positive Balance'
        : (
            $balanceIsNegative
                ? 'Debit Balance'
                : 'Balanced'
        );

    $balanceSign = $balance > 0
        ? '+'
        : (
            $balance < 0
                ? '-'
                : ''
        );

    $partnerEntries = collect(
        $partnerLedgerEntries ?? []
    );

    $profitShareCredits = $partnerEntries
        ->where('entry_category', 'profit_share')
        ->where('entry_type', 'credit')
        ->sum('amount');

    $lossShareDebits = $partnerEntries
        ->where('entry_category', 'loss_share')
        ->where('entry_type', 'debit')
        ->sum('amount');
@endphp

