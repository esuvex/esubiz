                            .trim();

                    if (!text) {
                        return;
                    }

                    const message =
                        document.createElement(
                            'div'
                        );

                    message.className =
                        'ml-6 rounded-lg bg-violet-600 p-3 text-xs leading-5 text-white';

                    message.textContent =
                        text;

                    aiChatMessages
