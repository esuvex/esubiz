        const widgetLibraryPanel =
            document.getElementById(
                'widgetLibraryPanel'
            );

        const widgetLibrarySearch =
            document.getElementById(
                'widgetLibrarySearch'
            );

        const closeWidgetLibraryButton =
            document.getElementById(
                'closeWidgetLibrary'
            );

        let widgetTarget = null;


        const openWidgetLibrary = function (
            sectionIndex,
            columnIndex
        ) {

            widgetTarget = {
                sectionIndex,
                columnIndex
            };

            widgetLibraryPanel
                ?.classList.remove(
                    'hidden'
                );

            if (widgetLibrarySearch) {

                widgetLibrarySearch.value =
                    '';

                widgetLibrarySearch.dispatchEvent(
                    new Event('input')
                );

                setTimeout(
                    () =>
                        widgetLibrarySearch.focus(),
                    50
                );
            }

        };


        const closeWidgetLibrary = function () {

            widgetLibraryPanel
                ?.classList.add(
                    'hidden'
                );

            widgetTarget = null;
        };


        closeWidgetLibraryButton
            ?.addEventListener(
                'click',
                closeWidgetLibrary
            );


        widgetLibrarySearch
            ?.addEventListener(
                'input',
                function () {

                    const query =
                        widgetLibrarySearch.value
                            .trim()
                            .toLowerCase();

                    document
                        .querySelectorAll(
                            '.widget-library-item'
                        )
                        .forEach(
                            function (item) {

                                const text =
                                    (
                                        item.dataset.widgetSearch
                                        || item.textContent
                                    )
                                        .toLowerCase();

                                item.classList.toggle(
                                    'hidden',
                                    query
                                    && !text.includes(query)
