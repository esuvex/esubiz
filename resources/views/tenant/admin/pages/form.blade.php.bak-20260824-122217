                        ].widgets[
                            Number(addSlide.dataset.widgetIndex)
                        ];

                    widget.slides =
                        Array.isArray(widget.slides)
                            ? widget.slides
                            : [];

                    widget.slides.push({
                        heading: 'New slide',
