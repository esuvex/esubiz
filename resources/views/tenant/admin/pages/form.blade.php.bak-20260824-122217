                    renderBuilder();
                    return;
                }

                const removeSlide =
                    event.target.closest(
                        '[data-hero-remove-slide]'
                    );

                if (removeSlide) {

                    const widget =
                        blocks[
                            Number(removeSlide.dataset.sectionIndex)
                        ].columns[
                            Number(removeSlide.dataset.columnIndex)
                        ].widgets[
                            Number(removeSlide.dataset.widgetIndex)
                        ];

                    if (
                        Array.isArray(widget.slides)
                        && widget.slides.length > 1
                    ) {
                        widget.slides.splice(
                            Number(removeSlide.dataset.slideIndex),
                            1
                        );

                        renderBuilder();
                    }
                }

            }
        );


        canvas.addEventListener(
            'input',
            function (event) {

                if (
                    event.target.dataset.heroSlideKey
                ) {

                    const widget =
                        blocks[
                            Number(event.target.dataset.sectionIndex)
                        ].columns[
                            Number(event.target.dataset.columnIndex)
                        ].widgets[
                            Number(event.target.dataset.widgetIndex)
