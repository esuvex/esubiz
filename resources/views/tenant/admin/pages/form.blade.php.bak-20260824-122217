                        '[data-hero-image-upload]'
                    )
                ) {

                    uploadHeroImage(
                        event.target
                    );

                    return;
                }


                if (
                    event.target.matches(
                        '[data-image-upload]'
                    )
                ) {
                    uploadTenantImage(
