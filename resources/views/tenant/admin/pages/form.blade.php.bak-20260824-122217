                return `
                    <select
                        ${attrs('form_id')}
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                    >

                        ${
                            availableForms.length
                                ? availableForms
                                    .map(
                                        form => `
                                            <option
                                                value="${form.id}"
                                                ${
                                                    String(widget.form_id)
                                                    === String(form.id)
                                                        ? 'selected'
                                                        : ''
                                                }
                                            >
                                                ${escapeHtml(form.name)}
                                            </option>
                                        `
                                    )
                                    .join('')
                                : `
                                    <option value="">
                                        No forms created yet
                                    </option>
                                `
                        }

                    </select>
                `;
            }


            /*
             * SPACER
             */
            if (widget.type === 'spacer') {

                return `
                    <input
                        type="number"
                        min="10"
                        max="200"
                        value="${Number(widget.height || 40)}"
                        ${attrs('height')}
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                    >
                `;
            }


            /*
             * DIVIDER
             */
            if (widget.type === 'divider') {

                return `
                    <div
                        class="rounded-lg bg-slate-50 p-3 text-xs text-slate-400"
                    >
                        Divider
                    </div>
                `;
            }


            return `
                <div class="text-xs text-slate-400">
                    Widget settings unavailable.
                </div>
            `;

        };


        const fields = function (
            block,
            index
        ) {

            switch (block.type) {

                case 'heading':

                    return (
                        input(
                            index,
                            'text',
                            block.text,
                            'Heading'
                        )
                        +
                        `
                        <label class="block">
                            <span class="text-xs font-bold text-slate-500">
                                Size
                            </span>

                            <select
                                data-index="${index}"
                                data-key="level"
                                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                            >
                                <option value="h1" ${block.level === 'h1' ? 'selected' : ''}>
                                    H1
                                </option>

                                <option value="h2" ${block.level === 'h2' ? 'selected' : ''}>
                                    H2
                                </option>

                                <option value="h3" ${block.level === 'h3' ? 'selected' : ''}>
                                    H3
                                </option>
                            </select>
                        </label>
                        `
                    );


                case 'text':

                    return input(
                        index,
                        'text',
                        block.text,
                        'Text',
                        true
                    );


                case 'button':

                    return (
                        input(
                            index,
                            'text',
                            block.text,
                            'Button Text'
                        )
                        +
                        input(
                            index,
                            'url',
                            block.url,
                            'Button URL'
                        )
                    );


                case 'image':

                    return (
                        input(
                            index,
                            'url',
                            block.url,
                            'Image URL'
                        )
                        +
                        input(
                            index,
                            'alt',
                            block.alt,
                            'Alt Text'
                        )
                    );


                case 'section':

                    const ratioOptions = [
                        '1',
                        '1:1',
                        '1:2',
                        '2:1',
                        '1:3',
                        '3:1',
                        '1:1:1',
                        '1:1:1:1'
                    ];

                    const columns =
                        block.columns || [];

                    const columnHtml =
                        columns
                            .map(
                                function (
                                    column,
                                    columnIndex
                                ) {

                                    const widgets =
                                        column.widgets || [];

                                    return `
                                        <div
                                            class="builder-column rounded-xl border border-blue-100 bg-white p-3"
                                            data-section-index="${index}"
                                            data-column-index="${columnIndex}"
                                        >

                                            <div
                                                class="mb-3 flex items-center justify-between gap-2"
                                            >

                                                <span
                                                    class="text-xs font-black text-slate-500"
                                                >
                                                    Column ${columnIndex + 1}
                                                </span>

                                                <button
                                                    type="button"
                                                    data-add-widget
                                                    data-section-index="${index}"
                                                    data-column-index="${columnIndex}"
                                                    class="rounded-lg bg-blue-50 px-2.5 py-1.5 text-xs font-bold text-blue-700"
                                                >
                                                    + Add Widget
                                                </button>

                                            </div>


                                            <div
                                                class="column-widget-list space-y-2"
                                                data-widget-dropzone
                                                data-section-index="${index}"
                                                data-column-index="${columnIndex}"
                                            >

                                                ${
                                                    widgets.length
                                                        ? widgets
                                                            .map(
                                                                function (
                                                                    widget,
                                                                    widgetIndex
                                                                ) {

                                                                    return `
                                                                        <div
                                                                            class="builder-widget cursor-move rounded-lg border border-slate-200 bg-slate-50 p-3"
                                                                            draggable="true"
                                                                            data-widget-index="${widgetIndex}"
                                                                            data-section-index="${index}"
                                                                            data-column-index="${columnIndex}"
                                                                        >

                                                                            <div
                                                                                class="flex items-center justify-between gap-2"
                                                                            >

                                                                                <span
                                                                                    class="text-xs font-black"
                                                                                >
                                                                                    ${blockTitle(widget.type)}
                                                                                </span>

                                                                                <button
                                                                                    type="button"
                                                                                    data-remove-widget
                                                                                    data-section-index="${index}"
                                                                                    data-column-index="${columnIndex}"
                                                                                    data-widget-index="${widgetIndex}"
                                                                                    class="text-xs font-bold text-red-600"
                                                                                >
                                                                                    Delete
                                                                                </button>

                                                                            </div>

                                                                            <div class="mt-3 grid gap-3">
                                                                                ${nestedWidgetFields(
                                                                                    widget,
                                                                                    index,
                                                                                    columnIndex,
                                                                                    widgetIndex
                                                                                )}
                                                                            </div>

                                                                        </div>
                                                                    `;
                                                                }
                                                            )
                                                            .join('')
                                                        : `
                                                            <div
                                                                class="rounded-lg border border-dashed border-slate-200 p-4 text-center text-xs text-slate-400"
                                                            >
                                                                No widgets in this column.
                                                            </div>
                                                        `
                                                }

                                            </div>

                                        </div>
                                    `;
                                }
                            )
                            .join('');


                    return `
                        ${input(
                            index,
                            'heading',
                            block.heading,
                            'Section Label / Heading'
                        )}

                        <label class="block">

                            <span
                                class="text-xs font-bold text-slate-500"
                            >
                                Column Ratio
                            </span>

                            <select
                                data-index="${index}"
                                data-key="ratio"
                                data-section-ratio
                                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                            >

                                ${
                                    ratioOptions
                                        .map(
                                            ratio => `
                                                <option
                                                    value="${ratio}"
                                                    ${
                                                        block.ratio === ratio
                                                            ? 'selected'
                                                            : ''
                                                    }
                                                >
                                                    ${ratio}
                                                </option>
                                            `
                                        )
                                        .join('')
                                }

                            </select>

                        </label>


                        <div
                            class="mt-4 grid gap-3"
                            style="grid-template-columns:${ratioToGrid(
                                block.ratio
                            )}"
                        >

                            ${columnHtml}

                        </div>
                    `;

                case 'columns2':

                    return (
                        input(
                            index,
                            'col1',
                            block.col1,
                            'Column 1',
                            true
                        )
                        +
                        input(
                            index,
                            'col2',
                            block.col2,
                            'Column 2',
                            true
                        )
                    );


                case 'columns3':

                    return (
                        input(
                            index,
                            'col1',
                            block.col1,
                            'Column 1',
                            true
                        )
                        +
                        input(
                            index,
                            'col2',
                            block.col2,
                            'Column 2',
                            true
                        )
                        +
                        input(
                            index,
                            'col3',
                            block.col3,
                            'Column 3',
                            true
                        )
                    );


                case 'form':

                    return `
                        <label class="block">

                            <span
                                class="text-xs font-bold text-slate-500"
                            >
                                Select Form
                            </span>

                            <select
                                data-index="${index}"
                                data-key="form_id"
                                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                            >

                                ${
                                    availableForms.length
                                        ? availableForms
                                            .map(
                                                form => `
                                                    <option
                                                        value="${form.id}"
                                                        ${
                                                            String(block.form_id)
                                                            === String(form.id)
                                                                ? 'selected'
                                                                : ''
                                                        }
                                                    >
                                                        ${escapeHtml(form.name)}
                                                    </option>
                                                `
                                            )
                                            .join('')
                                        : `
                                            <option value="">
                                                No forms created yet
                                            </option>
                                        `
                                }

                            </select>

                        </label>
                    `;


                case 'spacer':

                    return `
                        <label class="block">
                            <span class="text-xs font-bold text-slate-500">
                                Height
                            </span>

                            <input
                                type="number"
                                min="10"
                                max="200"
                                data-index="${index}"
                                data-key="height"
                                value="${block.height ?? 40}"
                                class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                            >
                        </label>
                    `;


                default:
                    return `
                        <div class="text-xs text-slate-400">
                            No settings required.
                        </div>
                    `;

            }

        };



        blocks.forEach(
            function (block) {

                if (block.type !== 'section') {
                    return;
                }

                if (!block.ratio) {
                    block.ratio = '1';
                }

                if (!Array.isArray(block.columns)) {

                    block.columns = [
                        {
                            widgets:
                                Array.isArray(block.children)
                                    ? block.children
                                    : []
                        }
                    ];

                    delete block.children;

                }

                applySectionRatio(
                    block,
                    block.ratio
                );

            }
        );


        const renderBuilder = function () {

            canvas
                .querySelectorAll(
                    '.builder-block'
                )
                .forEach(
                    element =>
                        element.remove()
                );


            empty.classList.toggle(
                'hidden',
                blocks.length > 0
            );


            blocks.forEach(
                function (
                    block,
                    index
                ) {

                    const element =
                        document.createElement(
                            'div'
                        );

                    element.className =
                        'builder-block rounded-2xl border border-slate-200 bg-white p-4 shadow-sm';

                    element.innerHTML = `
                        <div class="flex items-center justify-between gap-3">

                            <div class="flex items-center gap-3">

                                <div
                                    class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-xs font-black text-blue-600"
                                >
                                    ${index + 1}
                                </div>

                                <div class="font-black">
                                    ${blockTitle(block.type)}
                                </div>

                            </div>


                            <div class="flex gap-1">

                                <button
                                    type="button"
                                    data-action="up"
                                    data-index="${index}"
                                    class="rounded-lg border border-slate-200 px-2 py-1 text-xs"
                                >
                                    ↑
                                </button>

                                <button
                                    type="button"
                                    data-action="down"
                                    data-index="${index}"
                                    class="rounded-lg border border-slate-200 px-2 py-1 text-xs"
                                >
                                    ↓
                                </button>

                                <button
                                    type="button"
                                    data-action="remove"
                                    data-index="${index}"
                                    class="rounded-lg bg-red-50 px-2 py-1 text-xs font-bold text-red-600"
                                >
                                    Delete
                                </button>

                            </div>

                        </div>


                        <div
                            class="mt-4 grid gap-3"
                        >
                            ${fields(block, index)}
                        </div>
                    `;


                    canvas.appendChild(
                        element
                    );

                }
            );

        };


        const renderPublicBlock = function (block) {

            switch (block.type) {

                case 'hero':

                    const heroSlides =
                        Array.isArray(block.slides)
                            ? block.slides
                            : [];

                    if (!heroSlides.length) {
                        return '';
                    }

                    return `
                        <div
                            class="esubiz-hero-slider"
                            data-autoplay="${block.autoplay !== false ? '1' : '0'}"
                            data-interval="${Number(block.interval || 5000)}"
                            style="min-height:${Number(block.height || 520)}px"
                        >

                            ${
                                heroSlides
                                    .map(
                                        function (
                                            slide,
                                            index
                                        ) {

                                            return `
                                                <div
                                                    class="esubiz-hero-slide ${index === 0 ? 'is-active' : ''}"
                                                    ${
                                                        slide.image
                                                            ? `style="background-image:linear-gradient(rgba(15,23,42,.45),rgba(15,23,42,.45)),url('${escapeHtml(slide.image)}')"`
                                                            : ''
                                                    }
                                                >

                                                    <div class="esubiz-hero-content">

                                                        <h1>
                                                            ${escapeHtml(slide.heading || '')}
                                                        </h1>

                                                        <p>
                                                            ${escapeHtml(slide.text || '')}
                                                        </p>

                                                        ${
                                                            slide.button_text
                                                                ? `
                                                                    <a
                                                                        href="${escapeHtml(slide.button_url || '#')}"
                                                                        class="esubiz-widget-button"
                                                                    >
                                                                        ${escapeHtml(slide.button_text)}
                                                                    </a>
                                                                `
                                                                : ''
                                                        }

                                                    </div>

                                                </div>
                                            `;
                                        }
                                    )
                                    .join('')
                            }

                        </div>
                    `;


                case 'heading':

                    const level =
                        ['h1','h2','h3']
                            .includes(block.level)
                            ? block.level
                            : 'h2';

                    return `
                        <${level} class="esubiz-heading">
                            ${escapeHtml(block.text)}
                        </${level}>
                    `;


                case 'text':

                    return `
                        <p class="esubiz-text">
                            ${escapeHtml(block.text)}
                        </p>
                    `;


                case 'button':

                    return `
                        <p class="esubiz-button-wrap">
                            <a
                                class="esubiz-button"
                                href="${escapeHtml(block.url || '#')}"
                            >
                                ${escapeHtml(block.text)}
                            </a>
                        </p>
                    `;


                case 'image':

                    if (!block.url) {
                        return '';
                    }

                    return `
                        <figure class="esubiz-image">
                            <img
                                src="${escapeHtml(block.url)}"
                                alt="${escapeHtml(block.alt)}"
                            >
                        </figure>
                    `;


                case 'section':

                    const ratio =
                        block.ratio || '1';

                    const publicColumns =
                        (block.columns || [])
                            .map(
                                function (column) {

                                    return `
                                        <div class="esubiz-section-column">
                                            ${
                                                (column.widgets || [])
                                                    .map(renderPublicBlock)
                                                    .join('')
                                            }
                                        </div>
                                    `;

                                }
                            )
                            .join('');


                    return `
                        <section class="esubiz-section">

                            ${
                                block.heading
                                    ? `
                                        <h2>
                                            ${escapeHtml(block.heading)}
                                        </h2>
                                    `
                                    : ''
                            }

                            <div
                                class="esubiz-section-grid"
                                style="grid-template-columns:${ratioToGrid(ratio)}"
                            >
                                ${publicColumns}
                            </div>

                        </section>
                    `;


                case 'columns2':

                    return `
                        <div class="esubiz-grid esubiz-grid-2">

                            <div>
                                ${escapeHtml(block.col1)}
                            </div>

                            <div>
                                ${escapeHtml(block.col2)}
                            </div>

                        </div>
                    `;


                case 'columns3':

                    return `
                        <div class="esubiz-grid esubiz-grid-3">

                            <div>
                                ${escapeHtml(block.col1)}
                            </div>

                            <div>
                                ${escapeHtml(block.col2)}
                            </div>

                            <div>
                                ${escapeHtml(block.col3)}
                            </div>

                        </div>
                    `;


                case 'form':

                    if (!block.form_id) {

                        return `
                            <div class="esubiz-form-placeholder">
                                No form selected.
                            </div>
                        `;

                    }

                    const selected =
                        availableForms.find(
                            form =>
                                String(form.id)
                                === String(block.form_id)
                        );

                    return `
                        <div
                            class="esubiz-form-widget"
                            data-esubiz-form-id="${escapeHtml(block.form_id)}"
                        >
                            <div class="esubiz-form-placeholder">
                                ${
                                    selected
                                        ? escapeHtml(selected.name)
                                        : 'Website Form'
                                }
                            </div>
                        </div>
                    `;


                case 'divider':

                    return `
                        <hr class="esubiz-divider">
                    `;


                case 'spacer':

                    const height =
                        Math.min(
                            200,
                            Math.max(
                                10,
                                Number(block.height) || 40
                            )
                        );

                    return `
                        <div
                            class="esubiz-spacer"
                            style="height:${height}px"
                        ></div>
                    `;


                default:
                    return '';

            }

        };


        const generateHtml = function () {

            return blocks
                .map(renderPublicBlock)
                .join('\n');

        };


        document
            .querySelectorAll(
                '.builder-add'
            )
            .forEach(
                function (button) {

                    button.addEventListener(
                        'click',
                        function () {

                            blocks.push(
                                defaultBlock(
                                    button.dataset.addBlock
                                )
                            );

                            renderBuilder();

                        }
                    );

                }
            );



        canvas.addEventListener(
            'click',
            function (event) {

                const add =
                    event.target.closest(
                        '[data-add-widget]'
                    );

                if (add) {

                    const sectionIndex =
                        Number(
                            add.dataset.sectionIndex
                        );

                    const columnIndex =
                        Number(
                            add.dataset.columnIndex
                        );

                    openWidgetLibrary(
                        sectionIndex,
                        columnIndex
                    );

                    return;
                }


                const remove =
                    event.target.closest(
                        '[data-remove-widget]'
                    );

                if (remove) {

                    blocks[
                        Number(
                            remove.dataset.sectionIndex
                        )
                    ].columns[
                        Number(
                            remove.dataset.columnIndex
                        )
                    ].widgets.splice(
                        Number(
                            remove.dataset.widgetIndex
                        ),
                        1
                    );

                    renderBuilder();

                    return;
                }

            }
        );


        canvas.addEventListener(
            'change',
            function (event) {

                if (event.target.matches(
                    '[data-section-ratio]'
                )) {

                    const index =
                        Number(
                            event.target.dataset.index
                        );

                    applySectionRatio(
                        blocks[index],
                        event.target.value
                    );

                    renderBuilder();

                    return;
                }


                if (
                    event.target.dataset.nestedKey
                ) {

                    const section =
                        Number(
                            event.target.dataset.sectionIndex
                        );

                    const column =
                        Number(
                            event.target.dataset.columnIndex
                        );

                    const widget =
                        Number(
                            event.target.dataset.widgetIndex
                        );

                    const key =
                        event.target.dataset.nestedKey;

                    blocks[
                        section
                    ].columns[
                        column
                    ].widgets[
                        widget
                    ][key] =
                        event.target.value;

                }

            }
        );


        canvas.addEventListener(
            'input',
            function (event) {

                if (
                    event.target.dataset.nestedKey
                ) {

                    const section =
                        Number(
                            event.target.dataset.sectionIndex
                        );

                    const column =
                        Number(
                            event.target.dataset.columnIndex
                        );

                    const widget =
                        Number(
                            event.target.dataset.widgetIndex
                        );

                    blocks[
                        section
                    ].columns[
                        column
                    ].widgets[
                        widget
                    ][
                        event.target.dataset.nestedKey
                    ] = event.target.value;

                    return;
                }


                const target =
                    event.target;

                if (
                    !target.dataset.index
                    && target.dataset.index !== '0'
                ) {
                    return;
                }

                const index =
                    Number(
                        target.dataset.index
                    );

                const key =
                    target.dataset.key;

                if (
                    !blocks[index]
                    || !key
                ) {
                    return;
                }

                blocks[index][key] =
                    target.value;

            }
        );


        canvas.addEventListener(
            'change',
            function (event) {

                const target =
                    event.target;

                if (
                    target.dataset.index === undefined
                ) {
                    return;
                }

                const index =
                    Number(
                        target.dataset.index
                    );

                if (
                    blocks[index]
                    && target.dataset.key
                ) {
                    blocks[index][
                        target.dataset.key
                    ] = target.value;
                }

            }
        );


        canvas.addEventListener(
            'click',
            function (event) {

                const sectionButton =
                    event.target.closest(
                        '[data-section-add]'
                    );

                if (sectionButton) {

                    const sectionIndex =
                        Number(
                            sectionButton.dataset.index
                        );

                    const section =
                        blocks[sectionIndex];

                    if (
                        section
                        && section.type === 'section'
                    ) {

                        section.children =
                            section.children || [];

                        section.children.push(
                            defaultBlock(
                                sectionButton.dataset.sectionAdd
                            )
                        );

                        /*
                         * Basic Core implementation:
                         * child widgets are stored inside the
                         * section container. Premium builder can
                         * later provide drag/drop nested editing.
                         */
                        renderBuilder();

                    }

                    return;
                }

                const button =
                    event.target.closest(
                        '[data-action]'
                    );

                if (!button) {
                    return;
                }

                const index =
                    Number(
                        button.dataset.index
                    );

                switch (
                    button.dataset.action
                ) {

                    case 'remove':

                        blocks.splice(
                            index,
                            1
                        );

                        break;


                    case 'up':

                        if (index > 0) {

                            [
                                blocks[index - 1],
                                blocks[index]
                            ] = [
                                blocks[index],
                                blocks[index - 1]
                            ];

                        }

                        break;


                    case 'down':

                        if (
                            index
                            < blocks.length - 1
                        ) {

                            [
                                blocks[index + 1],
                                blocks[index]
                            ] = [
                                blocks[index],
                                blocks[index + 1]
                            ];

                        }

                        break;

                }

                renderBuilder();

            }
        );



        let draggedWidget = null;


        canvas.addEventListener(
            'dragstart',
            function (event) {

                const widget =
                    event.target.closest(
                        '.builder-widget'
                    );

                if (!widget) {
                    return;
                }

                draggedWidget = {
                    section:
                        Number(
                            widget.dataset.sectionIndex
                        ),

                    column:
                        Number(
                            widget.dataset.columnIndex
                        ),

                    widget:
                        Number(
                            widget.dataset.widgetIndex
                        )
                };

            }
        );


        canvas.addEventListener(
            'dragover',
            function (event) {

                if (
                    event.target.closest(
                        '[data-widget-dropzone]'
                    )
                ) {
                    event.preventDefault();
                }

            }
        );


        canvas.addEventListener(
            'drop',
            function (event) {

                const zone =
                    event.target.closest(
                        '[data-widget-dropzone]'
                    );

                if (
                    !zone
                    || !draggedWidget
                ) {
                    return;
                }

                event.preventDefault();

                const source =
                    blocks[
                        draggedWidget.section
                    ].columns[
                        draggedWidget.column
                    ].widgets;

                const [
                    widget
                ] = source.splice(
                    draggedWidget.widget,
                    1
                );

                const targetSection =
                    Number(
                        zone.dataset.sectionIndex
                    );

                const targetColumn =
                    Number(
                        zone.dataset.columnIndex
                    );

                blocks[
                    targetSection
                ].columns[
                    targetColumn
                ].widgets.push(
                    widget
                );

                draggedWidget = null;

                renderBuilder();

            }
        );



