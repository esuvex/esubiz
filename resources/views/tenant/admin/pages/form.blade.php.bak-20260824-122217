                                    rows="4"
                                    class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                >${safe}</textarea>
                            `
                            : `
                                <input
                                    type="text"
                                    data-index="${index}"
                                    data-key="${key}"
                                    value="${safe}"
                                    class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"
                                >
                            `
                    }
                </label>
            `;

        };



        const ratioParts = function (ratio) {

            return String(ratio || '1')
                .split(':')
                .map(
                    value =>
                        Math.max(
                            1,
                            Number(value) || 1
                        )
                );

        };


        const ratioToGrid = function (ratio) {

            return ratioParts(ratio)
                .map(
                    value =>
                        `${value}fr`
                )
                .join(' ');

        };


        const applySectionRatio = function (
            block,
            ratio
        ) {

            const count =
                ratioParts(ratio).length;

            block.ratio =
                ratio;

            block.columns =
                block.columns || [];

            while (
                block.columns.length < count
            ) {
                block.columns.push({
                    widgets: []
                });
            }

            if (
                block.columns.length > count
            ) {

                const removed =
                    block.columns.splice(count);

                if (
                    removed.length
                    && block.columns.length
                ) {

                    removed.forEach(
                        column => {

                            block.columns[
                                block.columns.length - 1
                            ].widgets.push(
                                ...(column.widgets || [])
                            );

                        }
                    );

                }

            }

        };


