                }
            }
        );


        canvas.addEventListener(
            'click',
            function (event) {

                const addSlide =
                    event.target.closest(
                        '[data-hero-add-slide]'
                    );

                if (addSlide) {

                    const widget =
                        blocks[
                            Number(addSlide.dataset.sectionIndex)
