        async function uploadHeroImage(input) {

            const file =
                input.files
                && input.files[0];

            if (!file) {
                return;
            }


            if (
                ![
                    'image/jpeg',
                    'image/png'
                ].includes(file.type)
            ) {

                alert(
                    'Only PNG and JPG images are allowed.'
                );

                input.value = '';

                return;
            }


            if (
                file.size
                > 10 * 1024 * 1024
            ) {

                alert(
                    'Image must not exceed 10 MB.'
                );

                input.value = '';

                return;
            }


            const sectionIndex =
                Number(
                    input.dataset.sectionIndex
                );

            const columnIndex =
                Number(
                    input.dataset.columnIndex
                );

            const widgetIndex =
                Number(
                    input.dataset.widgetIndex
                );

            const slideIndex =
                Number(
                    input.dataset.slideIndex
                );


            const widget =
                blocks[
                    sectionIndex
                ].columns[
                    columnIndex
                ].widgets[
                    widgetIndex
                ];


            const slide =
                widget.slides[
                    slideIndex
                ];


            if (!slide) {
                return;
            }


            const data =
                new FormData();

            data.append(
                'image',
                file
            );


            input.disabled = true;


            try {

                const response =
                    await fetch(
                        tenantCoreImageUploadUrl,
                        {
                            method: 'POST',

                            headers: {
                                'X-CSRF-TOKEN':
                                    csrfToken,

                                'Accept':
                                    'application/json'
                            },

                            body: data
                        }
                    );


                const payload =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        payload.message
                        || 'Hero image upload failed.'
                    );
                }


                slide.image =
                    payload.url;

                slide.uploaded_path =
                    payload.path;


                renderBuilder();

            } catch (error) {

                alert(
                    error.message
                    || 'Hero image upload failed.'
                );

            } finally {

                input.disabled = false;
            }

        }


        async function uploadTenantImage(input) {

            const file =
                input.files
                && input.files[0];

            if (!file) {
                return;
            }

            if (!['image/jpeg', 'image/png'].includes(file.type)) {
                alert('Only PNG and JPG images are allowed.');
                input.value = '';
                return;
            }

            if (file.size > 10 * 1024 * 1024) {
                alert('Image must not exceed 10 MB.');
                input.value = '';
                return;
            }

            const sectionIndex =
                Number(input.dataset.sectionIndex);

            const columnIndex =
                Number(input.dataset.columnIndex);

            const widgetIndex =
                Number(input.dataset.widgetIndex);

            const widget =
                blocks[
                    sectionIndex
                ].columns[
                    columnIndex
                ].widgets[
                    widgetIndex
                ];

            const data =
                new FormData();

            data.append(
                'image',
                file
            );

            input.disabled = true;

            try {

                const response =
                    await fetch(
                        tenantCoreImageUploadUrl,
                        {
                            method: 'POST',

                            headers: {
                                'X-CSRF-TOKEN':
                                    csrfToken,

                                'Accept':
                                    'application/json'
                            },

                            body: data
                        }
                    );

                const payload =
                    await response.json();

                if (!response.ok) {
                    throw new Error(
                        payload.message
                        || 'Image upload failed.'
                    );
                }

                widget.url =
                    payload.url;

                widget.uploaded_path =
                    payload.path;

                renderBuilder();

            } catch (error) {

                alert(
                    error.message
                    || 'Image upload failed.'
                );

            } finally {

                input.disabled = false;
            }

        }


        canvas.addEventListener(
            'change',
            function (event) {

                if (
                    event.target.matches(
                        '[data-hero-image-upload]'
                    )
                ) {

                    uploadHeroImage(
                        event.target
                    );

                    return;
                }


                if (
