        const escapeHtml = function (value) {

            const div =
                document.createElement('div');

            div.textContent =
                value ?? '';

            return div.innerHTML;

        };


        const blockTitle = function (type) {

            const titles = {
                heading: 'Heading',
                text: 'Text',
                button: 'Button',
                image: 'Image',
                section: 'Section',
                columns2: '2 Column Grid',
                columns3: '3 Column Grid',
                divider: 'Divider',
                spacer: 'Spacer',
                form: 'Form',
                hero: 'Hero / Slider'
            };

            return titles[type]
                || 'Block';

        };


        const defaultBlock = function (type) {

            switch (type) {

                case 'heading':
                    return {
                        type,
                        text: 'Your heading',
                        level: 'h2'
                    };

                case 'text':
                    return {
                        type,
                        text: 'Add your text here.'
                    };

                case 'button':
                    return {
                        type,
                        text: 'Learn More',
                        url: '#'
                    };

                case 'image':
                    return {
                        type,
                        url: '',
                        alt: '',
                        size: 'large',
                        custom_width: 800
                    };

                case 'section':
                    return {
                        type,
                        heading: '',
                        ratio: '1',
                        columns: [
                            {
                                widgets: []
                            }
                        ]
                    };

                case 'columns2':
                    return {
                        type,
                        col1: 'Column one',
                        col2: 'Column two'
                    };

                case 'columns3':
                    return {
                        type,
                        col1: 'Column one',
                        col2: 'Column two',
                        col3: 'Column three'
                    };

                case 'spacer':
                    return {
                        type,
                        height: 40
                    };

                case 'form':
                    return {
                        type,
                        form_id:
                            availableForms.length
                                ? String(
