                        ];

                    if (slide) {
                        slide[
                            event.target.dataset.heroSlideKey
                        ] = event.target.value;
                    }

                    return;
                }

                if (
                    event.target.dataset.heroSetting
                ) {

                    const widget =
                        blocks[
                            Number(event.target.dataset.sectionIndex)
                        ].columns[
                            Number(event.target.dataset.columnIndex)
                        ].widgets[
                            Number(event.target.dataset.widgetIndex)
                        ];

                    const key =
                        event.target.dataset.heroSetting;

                    widget[key] =
                        key === 'autoplay'
                            ? event.target.value === '1'
                            : Number(event.target.value);
                }

            }
        );



        /*
         * core-storage-upload-v4
         *
         * Image and Hero media use one upload path and therefore
         * consume the same tenant website storage allocation.
         */
        async function coreUploadImage(file) {

            if (
                !file
                || ![
                    'image/jpeg',
                    'image/png'
                ].includes(file.type)
            ) {
                throw new Error(
                    'Only JPG, JPEG and PNG images are allowed.'
                );
            }


            if (
                file.size
                > 10 * 1024 * 1024
            ) {
                throw new Error(
                    'Image must not exceed 10 MB.'
                );
            }


            const body =
                new FormData();

            body.append(
                'image',
                file
            );


            const response =
                await fetch(
                    tenantCoreImageUploadUrl,
                    {
                        method: 'POST',

                        headers: {
                            'X-CSRF-TOKEN':
                                csrfToken,

                            'Accept':
                                'application/json'
                        },

                        body
                    }
                );


            let payload = {};

            try {
                payload =
                    await response.json();
            } catch (_) {
                //
            }


            if (!response.ok) {

                throw new Error(
                    payload.message
                    || 'Image upload failed.'
                );
            }


            return payload;
        }


        canvas.addEventListener(
            'change',
            async function (event) {

                /*
                 * NORMAL IMAGE
                 */
                if (
                    event.target.matches(
                        '[data-core-image-upload]'
                    )
                ) {

                    const input =
                        event.target;

                    const file =
                        input.files?.[0];

                    if (!file) {
                        return;
                    }


                    const widget =
                        blocks[
                            Number(
                                input.dataset.sectionIndex
                            )
                        ].columns[
                            Number(
                                input.dataset.columnIndex
                            )
                        ].widgets[
                            Number(
                                input.dataset.widgetIndex
                            )
                        ];


                    input.disabled = true;


                    try {

                        const uploaded =
                            await coreUploadImage(
                                file
                            );


                        widget.url =
                            uploaded.url;

                        widget.uploaded_path =
                            uploaded.path;


                        renderBuilder();

                    } catch (error) {

                        alert(
                            error.message
                        );

                    } finally {

                        input.disabled = false;
                    }


                    return;
                }


                /*
                 * HERO / SLIDER IMAGE
                 */
                if (
                    event.target.matches(
                        '[data-core-hero-upload]'
                    )
                ) {

                    const input =
                        event.target;

                    const file =
                        input.files?.[0];

                    if (!file) {
                        return;
                    }


                    const widget =
                        blocks[
                            Number(
                                input.dataset.sectionIndex
                            )
                        ].columns[
                            Number(
                                input.dataset.columnIndex
                            )
                        ].widgets[
                            Number(
                                input.dataset.widgetIndex
                            )
                        ];


                    const slide =
                        widget.slides[
                            Number(
                                input.dataset.slideIndex
                            )
                        ];


                    input.disabled = true;


                    try {

                        const uploaded =
                            await coreUploadImage(
                                file
                            );


                        slide.image =
                            uploaded.url;

                        slide.uploaded_path =
                            uploaded.path;


                        renderBuilder();

                    } catch (error) {

                        alert(
                            error.message
                        );

                    } finally {

                        input.disabled = false;
                    }


                    return;
                }

            }
        );


        pageForm.addEventListener(
            'submit',
            function () {

                contentField.value =
                    generateHtml();

                jsonField.value =
                    JSON.stringify(
                        blocks
                    );

            }
        );


        document
            .getElementById(
                'previewButton'
            )
            .addEventListener(
                'click',
                function () {

                    previewContent.innerHTML =
                        generateHtml();

                    previewModal.classList.remove(
                        'hidden'
                    );

                    document.body.classList.add(
                        'overflow-hidden'
                    );

                }
            );


        document
            .getElementById(
                'closePreview'
            )
            .addEventListener(
                'click',
                function () {

                    previewModal.classList.add(
                        'hidden'
                    );

                    document.body.classList.remove(
                        'overflow-hidden'
                    );

                }
            );



        const titleInput =
            document.getElementById(
                'pageTitleInput'
            );

        const slugInput =
            document.getElementById(
                'pageSlugInput'
            );

        let slugManuallyEdited =
            slugInput
            && slugInput.value.trim() !== '';


        const makeSlug = function (value) {

            return String(value || '')
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');

        };


        if (
            titleInput
            && slugInput
        ) {

            titleInput.addEventListener(
                'input',
                function () {

                    if (
                        slugManuallyEdited
                    ) {
                        return;
                    }

                    slugInput.value =
                        makeSlug(
                            titleInput.value
                        );

                }
            );


            slugInput.addEventListener(
                'input',
                function () {

                    slugManuallyEdited =
                        slugInput.value.trim()
                        !== makeSlug(
                            titleInput.value
                        );

                }
            );

        }


        renderBuilder();

    }
);

