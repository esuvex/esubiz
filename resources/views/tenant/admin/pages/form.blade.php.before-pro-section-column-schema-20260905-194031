                                Section ${sectionIndex + 1}
                            </span>

                            <span
                                class="ml-2 text-xs text-slate-400"
                            >
                                ${ratios.join(' : ')}
                            </span>
                        </div>


                        <div class="flex flex-wrap gap-1">

                            <button
                                type="button"
                                data-section-action="up"
                                class="rounded-lg border px-2 py-1 text-xs"
