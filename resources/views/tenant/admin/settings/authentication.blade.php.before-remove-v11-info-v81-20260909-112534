        function (event) {
            const menuButton =
                event.target.closest(
                    '[data-auth-menu-button-v75]'
                );

            if (menuButton) {
                const menu =
                    menuButton.parentElement.querySelector(
                        '[data-auth-menu-v75]'
                    );

                const wasOpen =
                    menu
                    && menu.classList.contains(
                        'is-open'
                    );

                closeMenus();

                if (menu && !wasOpen) {
                    menu.classList.add('is-open');
                }

                event.stopPropagation();
                return;
            }

            const editButton =
                event.target.closest(
                    '[data-auth-edit-v75]'
                );

            if (editButton) {
                closeMenus();

                openEditor(
                    editButton.getAttribute(
                        'data-auth-edit-v75'
                    )
                );

                return;
            }

            if (
                event.target.closest(
                    '[data-auth-modal-close-v75]'
                )
            ) {
                closeModal();
                return;
            }

            closeMenus();
        }
    );


