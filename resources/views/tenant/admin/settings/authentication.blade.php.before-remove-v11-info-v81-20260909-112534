<script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        document
            .querySelectorAll('.provider-card')
            .forEach(function (card) {

                const radios =
                    card.querySelectorAll(
                        '[data-core-provider-mode-input]'
                    );

                const credentials =
                    card.querySelector(
                        '[data-core-custom-credentials]'
                    );

                const esubizHelp =
                    card.querySelector(
                        '[data-core-esubiz-help]'
                    );

                if (
                    !radios.length
                    || !credentials
                ) {
                    return;
                }

                const refresh = function () {

                    const selected =
                        card.querySelector(
                            '[data-core-provider-mode-input]:checked'
                        );

                    const mode =
                        selected
                            ? selected.value
                            : 'esubiz';

                    credentials.hidden =
                        mode !== 'custom';

                    if (esubizHelp) {
                        esubizHelp.hidden =
                            mode !== 'esubiz';
                    }
                };

                radios.forEach(
                    function (radio) {

                        radio.addEventListener(
                            'change',
                            refresh
                        );
                    }
                );

                refresh();
            });
    }
);
</script>

