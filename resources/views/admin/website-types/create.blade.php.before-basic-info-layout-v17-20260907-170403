<script>
const packageSearch = document.getElementById('package-search');
const packagePicker = document.getElementById('package-picker');
const packageKey = document.getElementById('package-key');
const packageVersion = document.getElementById('package-version');
const selectedPackage = document.getElementById('selected-package');
const selectedPackageName = document.getElementById('selected-package-name');
const selectedPackageVersion = document.getElementById('selected-package-version');

function choosePackage(option) {
    packageKey.value = option.dataset.key;
    packageVersion.value = option.dataset.version;

    packageSearch.value = option.dataset.key + ' / ' + option.dataset.version;

    selectedPackageName.textContent = option.dataset.key;
    selectedPackageVersion.textContent = option.dataset.version;

    selectedPackage.classList.remove('hidden');
    selectedPackage.classList.add('flex');

    packagePicker.classList.add('hidden');
}

packageSearch.addEventListener('focus', function () {
    packagePicker.classList.remove('hidden');
});

packageSearch.addEventListener('input', function () {
    const query = packageSearch.value.toLowerCase().trim();

    packagePicker.classList.remove('hidden');

    document.querySelectorAll('.package-option').forEach(function (option) {
        option.classList.toggle(
            'hidden',
            query !== '' && !option.dataset.label.includes(query)
        );
    });
});

document.querySelectorAll('.package-option').forEach(function (option) {
    option.addEventListener('click', function () {
        choosePackage(option);
    });
});

document.addEventListener('click', function (event) {
    if (!packageSearch.contains(event.target) && !packagePicker.contains(event.target)) {
        packagePicker.classList.add('hidden');
    }
});

const existingPackageKey = packageKey.value;
const existingPackageVersion = packageVersion.value;

if (existingPackageKey && existingPackageVersion) {
    const existingPackage = document.querySelector(
        '.package-option[data-key="' + existingPackageKey + '"][data-version="' + existingPackageVersion + '"]'
    );

    if (existingPackage) {
        choosePackage(existingPackage);
    } else {
        packageSearch.value = existingPackageKey + ' / ' + existingPackageVersion;
        selectedPackageName.textContent = existingPackageKey;
        selectedPackageVersion.textContent = existingPackageVersion;
        selectedPackage.classList.remove('hidden');
        selectedPackage.classList.add('flex');
    }
}
</script>

<script>
const iconSearch = document.getElementById('icon-search');
const iconPicker = document.getElementById('icon-picker');
const iconInput = document.getElementById('website-type-icon');
const selectedIcon = document.getElementById('selected-icon');
const selectedIconSymbol = document.getElementById('selected-icon-symbol');
const selectedIconName = document.getElementById('selected-icon-name');

function chooseIcon(option) {
    const emoji = option.querySelector('span:first-child').textContent.trim();
    const label = option.querySelector('span:last-child').textContent.trim();

    iconInput.value = option.dataset.icon;
    iconSearch.value = label;
    selectedIconSymbol.textContent = emoji;
    selectedIconName.textContent = label;

    selectedIcon.classList.remove('hidden');
    selectedIcon.classList.add('flex');
    iconPicker.classList.add('hidden');
}

iconSearch.addEventListener('focus', function () {
    iconPicker.classList.remove('hidden');
});

iconSearch.addEventListener('input', function () {
    const query = this.value.toLowerCase().trim();

    iconPicker.classList.remove('hidden');

    document.querySelectorAll('.icon-option').forEach(function (option) {
        option.classList.toggle(
            'hidden',
            query !== '' && !option.dataset.label.includes(query)
        );
    });
});

document.querySelectorAll('.icon-option').forEach(function (option) {
    option.addEventListener('click', function () {
        chooseIcon(option);
    });
});

document.addEventListener('click', function (event) {
    if (!iconSearch.contains(event.target) && !iconPicker.contains(event.target)) {
        iconPicker.classList.add('hidden');
    }
});

const existingIcon = iconInput.value;

if (existingIcon) {
    const existingOption = document.querySelector(
        '.icon-option[data-icon="' + existingIcon + '"]'
    );

    if (existingOption) {
        chooseIcon(existingOption);
    }
}
</script>

