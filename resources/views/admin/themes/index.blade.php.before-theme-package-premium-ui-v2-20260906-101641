<script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        const storageRadio =
            document.getElementById(
                'theme-package-source-storage'
            );

        const uploadRadio =
            document.getElementById(
                'theme-package-source-upload'
            );

        const storageGroup =
            document.getElementById(
                'theme-package-storage-group'
            );

        const uploadGroup =
            document.getElementById(
                'theme-package-upload-group'
            );

        const storageSelect =
            document.getElementById(
                'theme-package-storage'
            );

        const uploadInput =
            document.getElementById(
                'theme-package-upload'
            );


        function syncThemePackageSource() {

            const usingUpload =
                uploadRadio
                && uploadRadio.checked;


            storageGroup?.classList.toggle(
                'd-none',
                usingUpload
            );

            uploadGroup?.classList.toggle(
                'd-none',
                !usingUpload
            );


            if (storageSelect) {
                storageSelect.required =
                    !usingUpload;
            }


            if (uploadInput) {
                uploadInput.required =
                    usingUpload;
            }
        }


        storageRadio?.addEventListener(
            'change',
            syncThemePackageSource
        );

        uploadRadio?.addEventListener(
            'change',
            syncThemePackageSource
        );


        syncThemePackageSource();
    }
);
</script>



