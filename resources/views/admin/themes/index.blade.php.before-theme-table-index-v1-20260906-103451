<script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        const storageRadio =
            document.getElementById(
                'theme-package-source-storage'
            );

        const uploadRadio =
            document.getElementById(
                'theme-package-source-upload'
            );

        const storageGroup =
            document.getElementById(
                'theme-package-storage-group'
            );

        const uploadGroup =
            document.getElementById(
                'theme-package-upload-group'
            );

        const storageSelect =
            document.getElementById(
                'theme-package-storage'
            );

        const uploadInput =
            document.getElementById(
                'theme-package-upload'
            );


        function syncThemePackageSource() {

            const usingUpload =
                !!(
                    uploadRadio
                    && uploadRadio.checked
                );


            if (storageGroup) {
                storageGroup.style.display =
                    usingUpload
                        ? 'none'
                        : 'block';
            }


            if (uploadGroup) {
                uploadGroup.style.display =
                    usingUpload
                        ? 'block'
                        : 'none';
            }


            if (storageSelect) {
                storageSelect.required =
                    !usingUpload;

                storageSelect.disabled =
                    usingUpload;
            }


            if (uploadInput) {
                uploadInput.required =
                    usingUpload;

                uploadInput.disabled =
                    !usingUpload;
            }
        }


        storageRadio?.addEventListener(
            'change',
            syncThemePackageSource
        );

        uploadRadio?.addEventListener(
            'change',
            syncThemePackageSource
        );


        syncThemePackageSource();
    }
);
</script>



