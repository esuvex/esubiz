<script data-ai-avatar-preview-script>
document.addEventListener(
    'DOMContentLoaded',
    function () {

        document.querySelectorAll(
            '[data-ai-avatar-input]'
        ).forEach(
            function (input) {

                input.addEventListener(
                    'change',
                    function () {

                        const file =
                            input.files
                            && input.files[0];

                        const targetId =
                            input.getAttribute(
                                'data-ai-avatar-preview-target'
                            );

                        const box =
                            targetId
                                ? document.getElementById(
                                    targetId
                                )
                                : null;

                        const image =
                            box
                                ? box.querySelector(
                                    'img'
                                )
                                : null;


                        if (
                            !file
                            || !box
                            || !image
                        ) {

                            if (box) {
                                box.classList.add(
                                    'hidden'
                                );
                            }

                            return;
                        }


                        if (
                            !file.type
                                .startsWith(
                                    'image/'
                                )
                        ) {
                            return;
                        }


                        const url =
                            URL.createObjectURL(
                                file
                            );


                        image.src =
                            url;


                        box.classList.remove(
                            'hidden'
                        );


                        image.onload =
                            function () {

                                URL.revokeObjectURL(
                                    url
                                );
                            };
                    }
                );
            }
        );

    }
);
</script>



