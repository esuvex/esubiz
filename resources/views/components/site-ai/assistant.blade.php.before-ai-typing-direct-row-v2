<script>
(function () {

    const MAX_REFERENCE_IMAGES =
                    @json($esubizAiChatLimits['max_photos_per_message']);
    const MAX_REFERENCE_SIZE =
                    @json($esubizAiChatLimits['max_photo_size_mb'])
                    * 1024
                    * 1024;


    document.querySelectorAll(
        '[data-esubiz-site-ai]'
    ).forEach(
        function (root) {

            const launcher =
                root.querySelector(
                    '[data-site-ai-launcher]'
                );

            const panel =
                root.querySelector(
                    '[data-site-ai-panel]'
                );

            const closeButton =
                root.querySelector(
                    '[data-site-ai-close]'
                );

            const selectionStage =
                root.querySelector(
                    '[data-site-ai-selection-stage]'
                );

            const selectionActions =
                root.querySelector(
                    '[data-site-ai-selection-actions]'
                );

            const continueButton =
                root.querySelector(
                    '[data-site-ai-selection-continue]'
                );

            const chatStage =
                root.querySelector(
                    '[data-site-ai-chat-stage]'
                );

            const backButton =
                root.querySelector(
                    '[data-site-ai-back]'
                );

            const selectedSummary =
                root.querySelector(
                    '[data-site-ai-selected-summary]'
                );

            const contextMessage =
                root.querySelector(
                    '[data-site-ai-context-message]'
                );

            const referenceInput =
                root.querySelector(
                    '[data-site-ai-reference-input]'
                );

            const referencePreviews =
                root.querySelector(
                    '[data-site-ai-reference-previews]'
                );

            const viewer =
                root.querySelector(
                    '[data-site-ai-image-viewer]'
                );

            const viewerImage =
                root.querySelector(
                    '[data-site-ai-image-viewer-image]'
                );

            const viewerClose =
                root.querySelector(
                    '[data-site-ai-image-viewer-close]'
                );


            let referenceFiles = [];


            function selectedInputs() {

                return Array.from(
                    root.querySelectorAll(
                        '[data-site-ai-function]:checked'
                    )
                );
            }


            function selectedData() {

                return selectedInputs()
                    .map(
                        function (input) {

                            return {
                                key:
                                    input.value,

                                source:
                                    input.dataset
                                        .aiSource || '',

                                label:
                                    input.dataset
                                        .aiLabel || input.value,

                                description:
                                    input.dataset
                                        .aiDescription || '',

                                outputs:
                                    (
                                        input.dataset
                                            .aiOutputs || ''
                                    )
                                    .split(',')
                                    .map(
                                        value =>
                                            value.trim()
                                    )
                                    .filter(Boolean)
                            };
                        }
                    );
            }


            function syncContinue() {

                if (!selectionActions) {
                    return;
                }

                selectionActions.hidden =
                    selectedInputs()
                        .length === 0;
            }


            function renderSelectedContext() {

                if (!selectedSummary) {
                    return;
                }

                const selected =
                    selectedData();


                selectedSummary.innerHTML =
                    '';


                selected.forEach(
                    function (item) {

                        const tag =
                            document.createElement(
                                'span'
                            );

                        tag.className =
                            'esubiz-ai-selected-tag';

                        tag.textContent =
                            item.label;

                        selectedSummary
                            .appendChild(
                                tag
                            );
                    }
                );


                if (contextMessage) {

                    const imageJobs =
                        selected.filter(
                            item =>
                                item.outputs
                                    .includes(
                                        'image'
                                    )
                        );


                    let message =
                        'I can generate or improve '
                        + selected
                            .map(
                                item =>
                                    item.label
                            )
                            .join(', ')
                        + '.';


                    if (imageJobs.length) {

                        message +=
                            ' Image generation is available for '
                            + imageJobs
                                .map(
                                    item =>
                                        item.label
                                )
                                .join(', ')
                            + '.';
                    }


                    message +=
                        ' Describe the result you want, '
                        + 'and optionally attach reference photos.';


                    contextMessage.textContent =
                        message;
                }
            }


            function showSelection() {

                if (selectionStage) {
                    selectionStage.hidden =
                        false;
                }

                if (chatStage) {
                    chatStage.hidden =
                        true;
                }

                syncContinue();

                if (panel) {
                    panel.scrollTop = 0;
                }
            }


            function showChat() {

                if (
                    !selectedInputs()
                        .length
                ) {
                    showSelection();
                    return;
                }


                renderSelectedContext();


                if (selectionStage) {
                    selectionStage.hidden =
                        true;
                }

                if (chatStage) {
                    chatStage.hidden =
                        false;
                }


                if (panel) {
                    panel.scrollTop = 0;
                }
            }


            function openPanel() {

                if (!panel) {
                    return;
                }

                panel.dataset.open =
                    '1';

                panel.setAttribute(
                    'aria-hidden',
                    'false'
                );

                launcher?.setAttribute(
                    'aria-expanded',
                    'true'
                );
            }


            function closePanel() {

                if (!panel) {
                    return;
                }

                delete panel.dataset.open;

                panel.setAttribute(
                    'aria-hidden',
                    'true'
                );

                launcher?.setAttribute(
                    'aria-expanded',
                    'false'
                );
            }


            launcher?.addEventListener(
                'click',
                function () {

                    if (
                        panel?.dataset
                            .open === '1'
                    ) {
                        closePanel();
                    } else {
                        openPanel();
                    }
                }
            );


            closeButton?.addEventListener(
                'click',
                closePanel
            );


            root.addEventListener(
                'change',
                function (event) {

                    if (
                        event.target.matches(
                            '[data-site-ai-function]'
                        )
                    ) {
                        syncContinue();
                    }
                }
            );


            continueButton?.addEventListener(
                'click',
                showChat
            );


            backButton?.addEventListener(
                'click',
                showSelection
            );


            /*
             * =================================================
             * REFERENCE PHOTOS
             * =================================================
             */

            function renderReferences() {

                if (!referencePreviews) {
                    return;
                }

                referencePreviews.innerHTML =
                    '';


                referenceFiles.forEach(
                    function (file, index) {

                        const url =
                            URL.createObjectURL(
                                file
                            );


                        const item =
                            document.createElement(
                                'div'
                            );

                        item.className =
                            'esubiz-ai-reference-item';


                        const preview =
                            document.createElement(
                                'button'
                            );

                        preview.type =
                            'button';

                        preview.className =
                            'esubiz-ai-reference-thumb';

                        preview.innerHTML =
                            '<img alt="Reference photo">';


                        preview
                            .querySelector('img')
                            .src =
                                url;


                        preview.addEventListener(
                            'click',
                            function () {

                                if (
                                    !viewer
                                    || !viewerImage
                                ) {
                                    return;
                                }

                                viewerImage.src =
                                    url;

                                viewer.hidden =
                                    false;
                            }
                        );


                        const remove =
                            document.createElement(
                                'button'
                            );

                        remove.type =
                            'button';

                        remove.className =
                            'esubiz-ai-reference-remove';

                        remove.textContent =
                            '×';


                        remove.addEventListener(
                            'click',
                            function () {

                                referenceFiles
                                    .splice(
                                        index,
                                        1
                                    );

                                renderReferences();
                            }
                        );


                        item.appendChild(
                            preview
                        );

                        item.appendChild(
                            remove
                        );

                        referencePreviews
                            .appendChild(
                                item
                            );
                    }
                );
            }


            referenceInput?.addEventListener(
                'change',
                function () {

                    const incoming =
                        Array.from(
                            referenceInput.files
                            || []
                        );


                    for (
                        const file
                        of incoming
                    ) {

                        if (
                            referenceFiles.length
                            >= MAX_REFERENCE_IMAGES
                        ) {
                            alert(
                                'You can attach a maximum of '
                                + MAX_REFERENCE_IMAGES
                                + ' reference photo'
                                + (
                                    MAX_REFERENCE_IMAGES === 1
                                        ? '.'
                                        : 's.'
                                )
                            );
                            break;
                        }


                        if (
                            !file.type
