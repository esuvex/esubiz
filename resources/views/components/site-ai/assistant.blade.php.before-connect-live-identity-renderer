<script>
(function () {

    const MAX_REFERENCE_IMAGES = 5;
    const MAX_REFERENCE_SIZE =
        10 * 1024 * 1024;


    document.querySelectorAll(
        '[data-esubiz-site-ai]'
    ).forEach(
        function (root) {

            const launcher =
                root.querySelector(
                    '[data-site-ai-launcher]'
                );

            const panel =
                root.querySelector(
                    '[data-site-ai-panel]'
                );

            const closeButton =
                root.querySelector(
                    '[data-site-ai-close]'
                );

            const selectionStage =
                root.querySelector(
                    '[data-site-ai-selection-stage]'
                );

            const selectionActions =
                root.querySelector(
                    '[data-site-ai-selection-actions]'
                );

            const continueButton =
                root.querySelector(
                    '[data-site-ai-selection-continue]'
                );

            const chatStage =
                root.querySelector(
                    '[data-site-ai-chat-stage]'
                );

            const backButton =
                root.querySelector(
                    '[data-site-ai-back]'
                );

            const selectedSummary =
                root.querySelector(
                    '[data-site-ai-selected-summary]'
                );

            const contextMessage =
                root.querySelector(
                    '[data-site-ai-context-message]'
                );

            const referenceInput =
                root.querySelector(
                    '[data-site-ai-reference-input]'
                );

            const referencePreviews =
                root.querySelector(
                    '[data-site-ai-reference-previews]'
                );

            const viewer =
                root.querySelector(
                    '[data-site-ai-image-viewer]'
                );

            const viewerImage =
                root.querySelector(
                    '[data-site-ai-image-viewer-image]'
                );

            const viewerClose =
                root.querySelector(
                    '[data-site-ai-image-viewer-close]'
                );


            let referenceFiles = [];


            function selectedInputs() {

                return Array.from(
                    root.querySelectorAll(
                        '[data-site-ai-function]:checked'
                    )
                );
            }


            function selectedData() {

                return selectedInputs()
                    .map(
                        function (input) {

                            return {
                                key:
                                    input.value,

                                source:
                                    input.dataset
                                        .aiSource || '',

                                label:
                                    input.dataset
                                        .aiLabel || input.value,

                                description:
                                    input.dataset
                                        .aiDescription || '',

                                outputs:
                                    (
                                        input.dataset
                                            .aiOutputs || ''
                                    )
                                    .split(',')
                                    .map(
                                        value =>
                                            value.trim()
                                    )
                                    .filter(Boolean)
                            };
                        }
                    );
            }


            function syncContinue() {

                if (!selectionActions) {
                    return;
                }

                selectionActions.hidden =
                    selectedInputs()
                        .length === 0;
            }


            function renderSelectedContext() {

                if (!selectedSummary) {
                    return;
                }

                const selected =
                    selectedData();


                selectedSummary.innerHTML =
                    '';


                selected.forEach(
                    function (item) {

                        const tag =
                            document.createElement(
                                'span'
                            );

                        tag.className =
                            'esubiz-ai-selected-tag';

                        tag.textContent =
                            item.label;

                        selectedSummary
                            .appendChild(
                                tag
                            );
                    }
                );


                if (contextMessage) {

                    const imageJobs =
                        selected.filter(
                            item =>
                                item.outputs
                                    .includes(
                                        'image'
                                    )
                        );


                    let message =
                        'I can generate or improve '
                        + selected
                            .map(
                                item =>
                                    item.label
                            )
                            .join(', ')
                        + '.';


                    if (imageJobs.length) {

                        message +=
                            ' Image generation is available for '
                            + imageJobs
                                .map(
                                    item =>
                                        item.label
                                )
                                .join(', ')
                            + '.';
                    }


                    message +=
                        ' Describe the result you want, '
                        + 'and optionally attach reference photos.';


                    contextMessage.textContent =
                        message;
                }
            }


            function showSelection() {

                if (selectionStage) {
                    selectionStage.hidden =
                        false;
                }

                if (chatStage) {
                    chatStage.hidden =
                        true;
                }

                syncContinue();

                if (panel) {
                    panel.scrollTop = 0;
                }
            }


            function showChat() {

                if (
                    !selectedInputs()
                        .length
                ) {
                    showSelection();
                    return;
                }


                renderSelectedContext();


                if (selectionStage) {
                    selectionStage.hidden =
                        true;
                }

                if (chatStage) {
                    chatStage.hidden =
                        false;
                }


                if (panel) {
                    panel.scrollTop = 0;
                }
            }


            function openPanel() {

                if (!panel) {
                    return;
                }

                panel.dataset.open =
                    '1';

                panel.setAttribute(
                    'aria-hidden',
                    'false'
                );

                launcher?.setAttribute(
                    'aria-expanded',
                    'true'
                );
            }


            function closePanel() {

                if (!panel) {
                    return;
                }

                delete panel.dataset.open;

                panel.setAttribute(
                    'aria-hidden',
                    'true'
                );

                launcher?.setAttribute(
                    'aria-expanded',
                    'false'
                );
            }


            launcher?.addEventListener(
                'click',
                function () {

                    if (
                        panel?.dataset
                            .open === '1'
                    ) {
                        closePanel();
                    } else {
                        openPanel();
                    }
                }
            );


            closeButton?.addEventListener(
                'click',
                closePanel
            );


            root.addEventListener(
                'change',
                function (event) {

                    if (
                        event.target.matches(
                            '[data-site-ai-function]'
                        )
                    ) {
                        syncContinue();
                    }
                }
            );


            continueButton?.addEventListener(
                'click',
                showChat
            );


            backButton?.addEventListener(
                'click',
                showSelection
            );


            /*
             * =================================================
             * REFERENCE PHOTOS
             * =================================================
             */

            function renderReferences() {

                if (!referencePreviews) {
                    return;
                }

                referencePreviews.innerHTML =
                    '';


                referenceFiles.forEach(
                    function (file, index) {

                        const url =
                            URL.createObjectURL(
                                file
                            );


                        const item =
                            document.createElement(
                                'div'
                            );

                        item.className =
                            'esubiz-ai-reference-item';


                        const preview =
                            document.createElement(
                                'button'
                            );

                        preview.type =
                            'button';

                        preview.className =
                            'esubiz-ai-reference-thumb';

                        preview.innerHTML =
                            '<img alt="Reference photo">';


                        preview
                            .querySelector('img')
                            .src =
                                url;


                        preview.addEventListener(
                            'click',
                            function () {

                                if (
                                    !viewer
                                    || !viewerImage
                                ) {
                                    return;
                                }

                                viewerImage.src =
                                    url;

                                viewer.hidden =
                                    false;
                            }
                        );


                        const remove =
                            document.createElement(
                                'button'
                            );

                        remove.type =
                            'button';

                        remove.className =
                            'esubiz-ai-reference-remove';

                        remove.textContent =
                            '×';


                        remove.addEventListener(
                            'click',
                            function () {

                                referenceFiles
                                    .splice(
                                        index,
                                        1
                                    );

                                renderReferences();
                            }
                        );


                        item.appendChild(
                            preview
                        );

                        item.appendChild(
                            remove
                        );

                        referencePreviews
                            .appendChild(
                                item
                            );
                    }
                );
            }


            referenceInput?.addEventListener(
                'change',
                function () {

                    const incoming =
                        Array.from(
                            referenceInput.files
                            || []
                        );


                    for (
                        const file
                        of incoming
                    ) {

                        if (
                            referenceFiles.length
                            >= MAX_REFERENCE_IMAGES
                        ) {
                            alert(
                                'You can attach a maximum of 5 reference photos.'
                            );
                            break;
                        }


                        if (
                            !file.type
                                .startsWith(
                                    'image/'
                                )
                        ) {
                            continue;
                        }


                        if (
                            file.size
                            > MAX_REFERENCE_SIZE
                        ) {
                            alert(
                                file.name
                                + ' is larger than 10 MB.'
                            );

                            continue;
                        }


                        referenceFiles.push(
                            file
                        );
                    }


                    referenceInput.value =
                        '';


                    renderReferences();
                }
            );


            viewerClose?.addEventListener(
                'click',
                function () {

                    viewer.hidden =
                        true;

                    viewerImage.src =
                        '';
                }
            );


            viewer?.addEventListener(
                'click',
                function (event) {

                    if (
                        event.target === viewer
                    ) {

                        viewer.hidden =
                            true;

                        viewerImage.src =
                            '';
                    }
                }
            );


            document.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key
                        === 'Escape'
                    ) {

                        if (
                            viewer
                            && !viewer.hidden
                        ) {

                            viewer.hidden =
                                true;

                            viewerImage.src =
                                '';

                            return;
                        }


                        closePanel();
                    }
                }
            );


            /*
             * =================================================
             * ESUBIZ_LIVE_AI_CHAT_HANDLER
             * =================================================
             *
             * The browser never talks to OpenAI directly.
             *
             * Request path:
             *
             * Site AI form
             * -> TenantSiteAiController
             * -> SiteAiEngine
             * -> Esubiz Central AI
             * -> CentralAiEngine
             * -> OpenAI
             * -> Esubiz AI credit billing
             */

            const promptInput =
                root.querySelector(
                    '[data-site-ai-prompt]'
                );

            const sendButton =
                root.querySelector(
                    '[data-site-ai-send]'
                );

            const conversation =
                root.querySelector(
                    '[data-site-ai-conversation]'
                );


            function appendConversationMessage(
                role,
                message
            ) {

                if (
                    !conversation
                    || !message
                ) {
                    return;
                }


                const row =
                    document.createElement(
                        'div'
                    );

                row.className =
                    'esubiz-ai-chat-message '
                    + (
                        role === 'user'
                            ? 'esubiz-ai-chat-message-user'
                            : 'esubiz-ai-chat-message-assistant'
                    );


                const bubble =
                    document.createElement(
                        'div'
                    );

                bubble.className =
                    'esubiz-ai-chat-bubble';


                /*
                 * textContent deliberately prevents AI output
                 * from injecting HTML into the tenant dashboard.
                 */
                bubble.textContent =
                    String(
                        message
                    );


                row.appendChild(
                    bubble
                );

                conversation.appendChild(
                    row
                );


                conversation.scrollTop =
                    conversation.scrollHeight;
            }


            function extractAiResponse(
                response
            ) {

                const result =
                    response?.result;


                if (
                    typeof result === 'string'
                ) {
                    return result;
                }


                if (
                    result
                    && typeof result === 'object'
                ) {

                    const candidates = [
                        result.response,
                        result.text,
                        result.content,
                        result.message,
                        result.output,
                        result.answer,
                    ];


                    for (
                        const candidate
                        of candidates
                    ) {

                        if (
                            typeof candidate === 'string'
                            && candidate.trim() !== ''
                        ) {
                            return candidate;
                        }
                    }


                    if (
                        result.data
                        && typeof result.data === 'object'
                    ) {

                        const nested = [
                            result.data.response,
                            result.data.text,
                            result.data.content,
                            result.data.message,
                        ];


                        for (
                            const candidate
                            of nested
                        ) {

                            if (
                                typeof candidate === 'string'
                                && candidate.trim() !== ''
                            ) {
                                return candidate;
                            }
                        }
                    }


                    try {

                        return JSON.stringify(
                            result,
                            null,
                            2
                        );

                    } catch (error) {

                        return 'AI completed the request.';
                    }
                }


                return 'AI completed the request.';
            }


            async function sendAiRequest() {

                if (
                    !promptInput
                    || !sendButton
                ) {
                    return;
                }


                const prompt =
                    promptInput.value
                        .trim();


                if (!prompt) {

                    promptInput.focus();

                    return;
                }


                const selected =
                    selectedData();


                if (
                    !selected.length
                ) {

                    alert(
                        'Select at least one AI function first.'
                    );

                    showSelection();

                    return;
                }


                /*
                 * One request is sent for the selected capability.
                 *
                 * The backend remains the authority for routing,
                 * model selection and AI credit billing.
                 */
                const primary =
                    selected[0];


                const capability =
                    primary.key;


                /*
                 * Generic conversational action.
                 *
                 * Capability-specific SiteAiEngine adapters may
                 * normalize this further on the server.
                 */
                const action =
                    'generate';


                appendConversationMessage(
                    'user',
                    prompt
                );


                /*
                 * Clear the composer immediately after sending.
                 *
                 * The user's submitted message already exists in the
                 * conversation, so the textarea should be ready for a
                 * fresh prompt even if the AI request later fails.
                 */
                promptInput.value =
                    '';


                const originalButtonText =
                    sendButton.textContent;


                sendButton.disabled =
                    true;

                sendButton.textContent =
                    'Generating...';


                const requestPayload = {

                    capability:
                        capability,

                    action:
                        action,

                    prompt:
                        prompt,

                    payload: {

                        selected_functions:
                            selected.map(
                                item => item.key
                            ),

                        reference_images_count:
                            referenceFiles.length,
                    },

                    context: {

                        page_url:
                            window.location.href,

                        page_path:
                            window.location.pathname,

                        selected_functions:
                            selected,
                    },
                };


                try {

                    const response =
                        await fetch(
                            '/admin/site-ai/generate',
                            {
                                method:
                                    'POST',

                                credentials:
                                    'same-origin',

                                headers: {
                                    'Accept':
                                        'application/json',

                                    'Content-Type':
                                        'application/json',

                                    'X-CSRF-TOKEN':
                                        document
                                            .querySelector(
                                                'meta[name="csrf-token"]'
                                            )
                                            ?.getAttribute(
                                                'content'
                                            ) || '',
                                },

                                body:
                                    JSON.stringify(
                                        requestPayload
                                    ),
                            }
                        );


                    let data = {};


                    try {

                        data =
                            await response.json();

                    } catch (error) {

                        throw new Error(
                            'Esubiz AI returned an invalid response.'
                        );
                    }


                    if (
                        !response.ok
                        || data.success !== true
                    ) {

                        throw new Error(
                            data.message
                            || 'AI request could not be completed.'
                        );
                    }


                    const aiMessage =
                        extractAiResponse(
                            data
                        );


                    appendConversationMessage(
                        'assistant',
                        aiMessage
                    );


                    /*
                     * Notify other tenant UI components that an
                     * AI request completed. The balance widget can
                     * listen to this without coupling itself to
                     * this assistant.
                     */
                    window.dispatchEvent(
                        new CustomEvent(
                            'esubiz:ai:completed',
                            {
                                detail:
                                    data,
                            }
                        )
                    );


                } catch (error) {

                    appendConversationMessage(
                        'assistant',
                        error?.message
                        || 'Esubiz AI could not complete this request.'
                    );


                } finally {

                    sendButton.disabled =
                        false;

                    sendButton.textContent =
                        originalButtonText;

                    promptInput.focus();
                }
            }


            sendButton?.addEventListener(
                'click',
                sendAiRequest
            );


            promptInput?.addEventListener(
                'keydown',
                function (event) {

                    if (
                        event.key === 'Enter'
                        && !event.shiftKey
                    ) {

                        event.preventDefault();

                        sendAiRequest();
                    }
                }
            );



            /*
             * Browser API for future dynamic builders.
             */
            window.EsubizSiteAI =
                window.EsubizSiteAI
                || {};


            window.EsubizSiteAI.selected =
                selectedData;


            window.EsubizSiteAI.references =
                function () {
                    return referenceFiles;
                };


            window.EsubizSiteAI.open =
                openPanel;


            window.EsubizSiteAI.close =
                closePanel;


            /*
             * Correct initial state.
             */
            showSelection();
        }
    );

})();
</script>
